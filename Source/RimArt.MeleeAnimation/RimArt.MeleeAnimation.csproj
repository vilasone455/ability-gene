<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Melee Animation bridge. Its own assembly because it subclasses a Melee Animation type,
       and RimArt.dll must load without that mod installed. Built into Patch_MeleeAnimation, which
       loadFolders.xml reads only when Melee Animation is active. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RimArt.MeleeAnimation</AssemblyName>
    <RootNamespace>RimArt.MeleeAnimation</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\Patch_MeleeAnimation\1.6\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RimArt">
      <HintPath>$(MSBuildProjectDirectory)/../../1.6/Assemblies/RimArt.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="zAnimationMod">
      <HintPath>$(MeleeAnimationAssemblies)/zAnimationMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckMeleeAnimationAssembly" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MeleeAnimationAssemblies)/zAnimationMod.dll')"
           Text="zAnimationMod.dll not found. Install Melee Animation or set -p:MeleeAnimationAssemblies to its 1.6/Assemblies directory." />
  </Target>

</Project>
