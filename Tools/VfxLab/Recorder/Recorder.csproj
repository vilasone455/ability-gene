<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the mod's own drawing code outside the game and records every draw call.
    The files below are linked, not copied: the lab plays exactly what RimWorld would draw.
    Engine/ stands in for UnityEngine and Verse; add to it when a newly linked file names a
    member it lacks. Never edit a mod file to suit the lab.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RimArt.VfxLab</RootNamespace>
    <NoWarn>CS0169;CS0414;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The drawing helpers every ported picture shares (Shared/CastClips and ItemAbilityGrant are game code, not linked). -->
    <Compile Include="../../../Source/RimArt/Shared/VfxDraw.cs" Link="Linked/Shared/VfxDraw.cs" />
    <Compile Include="../../../Source/RimArt/Shared/VfxMath.cs" Link="Linked/Shared/VfxMath.cs" />
    <!-- Six Paths -->
    <Compile Include="../../../Source/RimArt/Debug/RimArtDebugAttribute.cs" Link="Linked/Debug/RimArtDebugAttribute.cs" />
    <Compile Include="../../../Source/RimArt/SixPaths/*.cs" LinkBase="Linked/SixPaths" />
    <!-- Flying Thunder God -->
    <Compile Include="../../../Source/RimArt/ThunderGod/*.cs" LinkBase="Linked/ThunderGod" />
    <!-- Drawing and previews only. The weapon and ability code goes in PowerPole/Kit, which is not linked here. -->
    <Compile Include="../../../Source/RimArt/PowerPole/*.cs" LinkBase="Linked/PowerPole" />
    <!-- Drawing and previews only, as for the Power Pole: the kit code will go in PaperBomb/Kit. -->
    <Compile Include="../../../Source/RimArt/PaperBomb/*.cs" LinkBase="Linked/PaperBomb" />
    <!-- Bank Shot: the ricochet rule, the charged shot's drawing and the previews. The weapon, the ability and the bouncing bullet are in BankShot/Kit, not linked here. -->
    <Compile Include="../../../Source/RimArt/BankShot/*.cs" LinkBase="Linked/BankShot" />
    <!-- Bubble Pipe: drawing, timing and previews only. The weapon and ability code is in BubblePipe/Kit, not linked here. -->
    <Compile Include="../../../Source/RimArt/BubblePipe/*.cs" LinkBase="Linked/BubblePipe" />
    <!-- Water Gun: drawing and previews only. The weapon and ability code is in WaterGun/Kit, which is not linked here. -->
    <Compile Include="../../../Source/RimArt/WaterGun/*.cs" LinkBase="Linked/WaterGun" />
    <!-- Chain Sickle: the weight rule, drawing, timing and previews only. The weapon and ability code is in ChainSickle/Kit, which is not linked here. -->
    <Compile Include="../../../Source/RimArt/ChainSickle/*.cs" LinkBase="Linked/ChainSickle" />
    <!-- Flame Gauntlet: drawing, timing and previews only. The weapon and ability code is in FlameGauntlet/Kit, which is not linked here. -->
    <Compile Include="../../../Source/RimArt/FlameGauntlet/*.cs" LinkBase="Linked/FlameGauntlet" />
    <!-- Vacuum: drawing, timing and previews only. The weapon and ability code is in Vacuum/Kit, which is not linked here. -->
    <Compile Include="../../../Source/RimArt/Vacuum/*.cs" LinkBase="Linked/Vacuum" />
    <!-- Samehada: drawing, timing and previews only. The weapon and ability code is in Samehada/Kit, which is not linked here. -->
    <Compile Include="../../../Source/RimArt/Samehada/*.cs" LinkBase="Linked/Samehada" />
    <!-- Coil Gun: drawing, timing and previews only. The weapon, ability and projectile code is in CoilGun/Kit, which is not linked here. -->
    <Compile Include="../../../Source/RimArt/CoilGun/*.cs" LinkBase="Linked/CoilGun" />
    <!-- Shadow Plexus: drawing and previews only. -->
    <Compile Include="../../../Source/RimArt/ShadowPlexus/*.cs" LinkBase="Linked/ShadowPlexus" />
    <!-- Goku: drawing and previews only. -->
    <Compile Include="../../../Source/RimArt/Goku/*.cs" LinkBase="Linked/Goku" />
    <Compile Include="../../../Source/RimArt/Vergil/*.cs" LinkBase="Linked/Vergil" />
    <!-- Gojo: Unlimited Void's drawing and previews only. -->
    <Compile Include="../../../Source/RimArt/Gojo/*.cs" LinkBase="Linked/Gojo" />
    <!-- Infinity Castle: the castle's drawing, its generator and the previews. The pocket map (GenStep, map component, defs) is in InfinityCastle/Kit, not linked here. -->
    <Compile Include="../../../Source/RimArt/InfinityCastle/*.cs" LinkBase="Linked/InfinityCastle" />
    <!-- Kamui dimension (Obito): the dimension's generator, its drawing and the preview. The pocket map itself (GenStep, map component, defs) is the Fold organ's, in Involute/, not linked here. -->
    <Compile Include="../../../Source/RimArt/Involute/Kamui/*.cs" LinkBase="Linked/Kamui" />
    <!-- Trace: Unlimited Blade Works' drawing, timing, field layout and previews. The pocket map (GenStep, map component, the atlas built from the weapons' textures, defs) is in Trace/Kit, not linked here. -->
    <Compile Include="../../../Source/RimArt/Trace/*.cs" LinkBase="Linked/Trace" />
    <Compile Include="../../../Source/RimArt/Anchor/ClapTeleport.cs" Link="Linked/Anchor/ClapTeleport.cs" />
    <Compile Include="../../../Source/RimArt/Anchor/ClapTeleportGraphics.cs" Link="Linked/Anchor/ClapTeleportGraphics.cs" />
    <Compile Include="../../../Source/RimArt/Anchor/DebugActions_ClapTeleport.cs" Link="Linked/Anchor/DebugActions_ClapTeleport.cs" />
    <Compile Include="../../../Source/RimArt/Anchor/MarkFlick.cs" Link="Linked/Anchor/MarkFlick.cs" />
    <Compile Include="../../../Source/RimArt/Anchor/DebugActions_MarkFlick.cs" Link="Linked/Anchor/DebugActions_MarkFlick.cs" />
    <!-- Gravity Well -->
    <Compile Include="../../../Source/RimArt/Gravity/GravityGraphics.cs" Link="Linked/Gravity/GravityGraphics.cs" />
    <Compile Include="../../../Source/RimArt/Gravity/GravityRules.cs" Link="Linked/Gravity/GravityRules.cs" />
    <Compile Include="../../../Source/RimArt/Gravity/DebugActions_Gravity.cs" Link="Linked/Gravity/DebugActions_Gravity.cs" />
    <!-- Shinra Tensei -->
    <Compile Include="../../../Source/RimArt/Shinra/ShinraVfxGraphics.cs" Link="Linked/Shinra/ShinraVfxGraphics.cs" />
    <Compile Include="../../../Source/RimArt/Shinra/ShinraVfxTiming.cs" Link="Linked/Shinra/ShinraVfxTiming.cs" />
    <Compile Include="../../../Source/RimArt/Shinra/ShinraCharge.cs" Link="Linked/Shinra/ShinraCharge.cs" />
    <Compile Include="../../../Source/RimArt/Shinra/ShinraSound.cs" Link="Linked/Shinra/ShinraSound.cs" />
    <Compile Include="../../../Source/RimArt/Shinra/MapComponent_ShinraVfx.cs" Link="Linked/Shinra/MapComponent_ShinraVfx.cs" />
    <Compile Include="../../../Source/RimArt/Shinra/DebugActions_ShinraVfx.cs" Link="Linked/Shinra/DebugActions_ShinraVfx.cs" />
  </ItemGroup>
</Project>
