<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Echoes: heroes a colonist can become (docs/hero-echo.md). Every number is a placeholder.
       Accelerator and Pain reuse abilities that already work in game; Inumaki's six words and Shikamaru's
       Shadow plexus are ported kits and only their Echoes grant them; Vergil has no
       abilities until his kit is ported and is here to exercise the kill-with-weapon trial.
       Shirou's one ability so far is Unlimited Blade Works, not yet played by hand. -->
  <RimArt.EchoDef Name="AG_EchoBase" Abstract="True">
    <bodyType>Thin</bodyType>
  </RimArt.EchoDef>

  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Accelerator</defName>
    <label>Accelerator</label>
    <subtitle>One Who Turns All Vectors</subtitle>
    <description>Nothing that touches him keeps its direction.</description>
    <order>10</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>12</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>DamageTaken</record>
        <count>300</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Abrasive</trait>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_VectorReflection</li>
      <li>AG_VectorSurge</li>
      <li>AG_VectorShove</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Accelerator</manifestHediff>
    <upkeepPerHour>12</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_VectorSurge</ability>
        <cost>10</cost>
      </li>
      <li>
        <ability>AG_VectorShove</ability>
        <cost>8</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.95, 0.95, 0.95)</hairColor>
  </RimArt.EchoDef>

  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Pain</defName>
    <label>Pain</label>
    <subtitle>Judge of the Rippled Eye</subtitle>
    <description>He pulls and pushes the world at will.</description>
    <order>20</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>10</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>Kills</record>
        <count>25</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Nerves</trait>
        <degree>2</degree>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_ShinraTensei</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Pain</manifestHediff>
    <upkeepPerHour>15</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_ShinraTensei</ability>
        <cost>20</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.95, 0.45, 0.1)</hairColor>
  </RimArt.EchoDef>

  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Inumaki</defName>
    <label>Inumaki</label>
    <subtitle>Voice That Must Not Speak</subtitle>
    <description>He speaks rarely, and the word is law.</description>
    <order>30</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Social</skill>
        <level>10</level>
      </li>
      <li Class="RimArt.Trial_NotTrait">
        <trait>Psychopath</trait>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Kind</trait>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_Imperative_Stop</li>
      <li>AG_Imperative_Drop</li>
      <li>AG_Imperative_Crush</li>
      <li>AG_Imperative_Come</li>
      <li>AG_Imperative_Run</li>
      <li>AG_Imperative_Explode</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Inumaki</manifestHediff>
    <upkeepPerHour>8</upkeepPerHour>
    <!-- No castCosts: every word costs 0 charge. The throat (AG_LarynxWear) is his cost. -->
    <wealth>3000</wealth>
    <hairColor>(0.92, 0.92, 0.95)</hairColor>
  </RimArt.EchoDef>

  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Vergil</defName>
    <label>Vergil</label>
    <subtitle>Son of the Dark Knight</subtitle>
    <description>His sword cuts from farther than he stands.</description>
    <order>40</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>16</level>
      </li>
      <li Class="RimArt.Trial_KillsWith">
        <weapons>
          <li>MeleeWeapon_LongSword</li>
        </weapons>
        <weaponLabel>longsword</weaponLabel>
        <count>20</count>
      </li>
      <li Class="RimArt.Trial_NotTrait">
        <trait>Wimp</trait>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Bloodlust</trait>
      </li>
    </forcedTraits>
    <manifestHediff>AG_EchoManifest_Vergil</manifestHediff>
    <upkeepPerHour>10</upkeepPerHour>
    <wealth>6000</wealth>
    <hairColor>(0.85, 0.87, 0.9)</hairColor>
  </RimArt.EchoDef>

  <!-- Shikamaru: the kit is Shadow plexus (AG_ShadowPlexus_Abilities.xml), only this Echo grants it.
       The modExtension holds the rule numbers every ability shares: the light rule and what cuts a
       shadow line. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Shikamaru</defName>
    <label>Shikamaru</label>
    <subtitle>Strategist of the Binding Shadow</subtitle>
    <description>Where his shadow reaches, nothing moves but by his leave.</description>
    <order>45</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>14</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>PeopleCaptured</record>
        <count>5</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Industriousness</trait>
        <degree>-1</degree>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_ShadowImitation</li>
      <li>AG_ShadowSeam</li>
      <li>AG_ShadowGrasp</li>
      <li>AG_ShadowDouble</li>
      <li>AG_ShadowNeckBind</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Shikamaru</manifestHediff>
    <upkeepPerHour>10</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_ShadowImitation</ability>
        <cost>3</cost>
      </li>
      <li>
        <ability>AG_ShadowSeam</ability>
        <cost>3</cost>
      </li>
      <li>
        <ability>AG_ShadowGrasp</ability>
        <cost>1</cost>
      </li>
      <li>
        <ability>AG_ShadowDouble</ability>
        <cost>5</cost>
      </li>
      <li>
        <ability>AG_ShadowNeckBind</ability>
        <cost>2</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.08, 0.08, 0.1)</hairColor>
    <modExtensions>
      <li Class="RimArt.ShadowPlexusExtension">
        <skyShare>0.5</skyShare>
        <darkBelow>0.3</darkBelow>
        <smokeDensity>0.15</smokeDensity>
        <minCrossingBodySize>0.9</minCrossingBodySize>
      </li>
    </modExtensions>
  </RimArt.EchoDef>

  <!-- Shirou: the way in is Origin: Blade (Melee 14, Crafting 12, five blades studied, then awakened),
       so the Trial is the trait itself. No forced trait: awakening Origin: Blade already cost psycasts
       and ranged weapons for life. Unlimited Blade Works also keeps its own 2-day cooldown. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Shirou</defName>
    <label>Shirou</label>
    <subtitle>The Faker</subtitle>
    <description>Every blade he has seen, he can make again.</description>
    <order>50</order>
    <trials>
      <li Class="RimArt.Trial_Trait">
        <trait>AG_OriginBlade</trait>
      </li>
    </trials>
    <abilities>
      <li>AG_Trace_UnlimitedBladeWorks</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Shirou</manifestHediff>
    <upkeepPerHour>12</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_Trace_UnlimitedBladeWorks</ability>
        <cost>40</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.72, 0.3, 0.16)</hairColor>
  </RimArt.EchoDef>

  <!-- Itachi (docs/hero-echo.md, "Itachi"). The dispersal plexus is his Echo-only organ: given on
       awakening, kept for life, but Scatter, Crow Dispersal and Carrion work only in hero form. The
       crow abilities cost no charge (they spend the plexus's three charges); False Face and Susanoo
       cost charge. Sickly is vanilla Immunity at degree -1: his illness. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Itachi</defName>
    <label>Itachi</label>
    <subtitle>Crow of the Crimson Eye</subtitle>
    <description>He is never where the blow lands, and what looks at him sees what he chooses.</description>
    <order>60</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>12</level>
      </li>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>12</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>Kills</record>
        <count>30</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Immunity</trait>
        <degree>-1</degree>
      </li>
    </forcedTraits>
    <awakenGenes>
      <li MayRequire="Ludeon.RimWorld.Biotech">AG_DispersalPlexus</li>
    </awakenGenes>
    <abilities>
      <li>AG_DispersalMurder</li>
      <li>AG_DispersalCarrion</li>
      <li>AG_ItachiFalseFace</li>
      <li>AG_ItachiSusanoo</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Itachi</manifestHediff>
    <upkeepPerHour>10</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_ItachiFalseFace</ability>
        <cost>3</cost>
      </li>
      <li>
        <ability>AG_ItachiSusanoo</ability>
        <cost>20</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.08, 0.08, 0.1)</hairColor>
  </RimArt.EchoDef>

  <!-- Goku (docs/heroes.md): the four abilities are his own (AG_Goku_Abilities.xml); Warp Kamehameha
       is a button during the Kamehameha hold that spends Instant Transmission's cost and cooldown too.
       The downed-and-recovered Trial counts from the moment the mod is loaded. Every number is a
       placeholder. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Goku</defName>
    <label>Goku</label>
    <subtitle>Heir of the Monkey King</subtitle>
    <description>He gets back up, and hits harder each time.</description>
    <order>70</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>15</level>
      </li>
      <li Class="RimArt.Trial_DownedRecovered">
        <count>3</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Gourmand</trait>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_GokuSolarFlare</li>
      <li>AG_GokuInstantTransmission</li>
      <li>AG_GokuKamehameha</li>
      <li>AG_GokuSpiritBomb</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Goku</manifestHediff>
    <upkeepPerHour>12</upkeepPerHour>
    <castCosts>
      <li><ability>AG_GokuSolarFlare</ability><cost>3</cost></li>
      <li><ability>AG_GokuInstantTransmission</ability><cost>2</cost></li>
      <li><ability>AG_GokuKamehameha</ability><cost>15</cost></li>
      <li><ability>AG_GokuSpiritBomb</ability><cost>30</cost></li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.08, 0.08, 0.1)</hairColor>
  </RimArt.EchoDef>

</Defs>
