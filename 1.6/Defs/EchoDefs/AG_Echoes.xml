<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Echoes: heroes a colonist can become (docs/hero-echo.md). Every number is a placeholder.
       Accelerator and Pain reuse abilities that already work in game; Inumaki's six words and Shikamaru's
       Shadow plexus are ported kits and only their Echoes grant them; Vergil has no
       abilities until his kit is ported and is here to exercise the kill-with-weapon trial.
       Shirou has Reinforcement, Trace On and Unlimited Blade Works, with its commands inside the world. -->
  <RimArt.EchoDef Name="AG_EchoBase" Abstract="True">
    <bodyType>Thin</bodyType>
  </RimArt.EchoDef>

  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Accelerator</defName>
    <label>Accelerator</label>
    <subtitle>One Who Turns All Vectors</subtitle>
    <description>Nothing that touches him keeps its direction.</description>
    <order>10</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>12</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>DamageTaken</record>
        <count>300</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Abrasive</trait>
      </li>
    </forcedTraits>
    <!-- Brain strain is his cost (AG_VectorStrain): none of the five costs Echo charge. -->
    <abilities>
      <li>AG_VectorReflection</li>
      <li>AG_VectorSurge</li>
      <li>AG_VectorShove</li>
      <li>AG_VectorPlasma</li>
      <li>AG_VectorFlick</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Accelerator</manifestHediff>
    <upkeepPerHour>12</upkeepPerHour>
    <wealth>6000</wealth>
    <hairColor>(0.95, 0.95, 0.95)</hairColor>
  </RimArt.EchoDef>

  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Inumaki</defName>
    <label>Inumaki</label>
    <subtitle>Voice That Must Not Speak</subtitle>
    <description>He speaks rarely, and the word is law.</description>
    <order>30</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Social</skill>
        <level>10</level>
      </li>
      <li Class="RimArt.Trial_NotTrait">
        <trait>Psychopath</trait>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Kind</trait>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_Imperative_Stop</li>
      <li>AG_Imperative_Drop</li>
      <li>AG_Imperative_Crush</li>
      <li>AG_Imperative_Come</li>
      <li>AG_Imperative_Run</li>
      <li>AG_Imperative_Explode</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Inumaki</manifestHediff>
    <upkeepPerHour>8</upkeepPerHour>
    <!-- No castCosts: every word costs 0 charge. The throat (AG_LarynxWear) is his cost. -->
    <wealth>3000</wealth>
    <hairColor>(0.92, 0.92, 0.95)</hairColor>
  </RimArt.EchoDef>

  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Vergil</defName>
    <label>Vergil</label>
    <subtitle>Son of the Dark Knight</subtitle>
    <description>His sword cuts from farther than he stands.</description>
    <order>40</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>16</level>
      </li>
      <li Class="RimArt.Trial_KillsWith">
        <weapons>
          <li>MeleeWeapon_LongSword</li>
        </weapons>
        <weaponLabel>longsword</weaponLabel>
        <count>20</count>
      </li>
      <li Class="RimArt.Trial_NotTrait">
        <trait>Wimp</trait>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Bloodlust</trait>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_VergilJudgementCut</li>
      <li>AG_VergilYamatoDash</li>
      <li>AG_VergilSummonedSwords</li>
      <li>AG_VergilJudgementCutEnd</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Vergil</manifestHediff>
    <manifestWeapon>AG_Yamato</manifestWeapon>
    <upkeepPerHour>10</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_VergilJudgementCut</ability>
        <cost>3</cost>
      </li>
      <li>
        <ability>AG_VergilYamatoDash</ability>
        <cost>2</cost>
      </li>
      <li>
        <ability>AG_VergilSummonedSwords</ability>
        <cost>10</cost>
      </li>
      <li>
        <ability>AG_VergilJudgementCutEnd</ability>
        <cost>0</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.85, 0.87, 0.9)</hairColor>
    <!-- Style, DMC's style meter: 0-100 while manifested, shown on its gizmo as a letter rank.
         Judgement Cut End needs rank S and spends all of it. Only hits on hostile pawns count.
         Source/RimArt/Vergil/Kit/VergilStyle.cs. -->
    <modExtensions>
      <li Class="RimArt.VergilStyleExtension">
        <max>100</max>
        <ranks>
          <li><label>D</label><from>0</from></li>
          <li><label>C</label><from>15</from></li>
          <li><label>B</label><from>30</from></li>
          <li><label>A</label><from>45</from></li>
          <li><label>S</label><from>60</from></li>
          <li><label>SS</label><from>75</from></li>
          <li><label>SSS</label><from>90</from></li>
        </ranks>
        <cutEndNeeds>60</cutEndNeeds>
        <meleeHit>2</meleeHit>
        <damageTaken>20</damageTaken>
        <drainPerSecond>5</drainPerSecond>
        <drainAfterSeconds>10</drainAfterSeconds>
      </li>
    </modExtensions>
  </RimArt.EchoDef>

  <!-- Shikamaru: the kit is Shadow plexus (AG_ShadowPlexus_Abilities.xml), only this Echo grants it.
       The modExtension holds the rule numbers every ability shares: the light rule and what cuts a
       shadow line. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Shikamaru</defName>
    <label>Shikamaru</label>
    <subtitle>Strategist of the Binding Shadow</subtitle>
    <description>Where his shadow reaches, nothing moves but by his leave.</description>
    <order>45</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>14</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>PeopleCaptured</record>
        <count>5</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Industriousness</trait>
        <degree>-1</degree>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_ShadowImitation</li>
      <li>AG_ShadowSeam</li>
      <li>AG_ShadowGrasp</li>
      <li>AG_ShadowDouble</li>
      <li>AG_ShadowNeckBind</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Shikamaru</manifestHediff>
    <upkeepPerHour>10</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_ShadowImitation</ability>
        <cost>3</cost>
      </li>
      <li>
        <ability>AG_ShadowSeam</ability>
        <cost>3</cost>
      </li>
      <li>
        <ability>AG_ShadowGrasp</ability>
        <cost>1</cost>
      </li>
      <li>
        <ability>AG_ShadowDouble</ability>
        <cost>5</cost>
      </li>
      <li>
        <ability>AG_ShadowNeckBind</ability>
        <cost>2</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.08, 0.08, 0.1)</hairColor>
    <modExtensions>
      <li Class="RimArt.ShadowPlexusExtension">
        <skyShare>0.5</skyShare>
        <darkBelow>0.3</darkBelow>
        <smokeDensity>0.15</smokeDensity>
        <minCrossingBodySize>0.9</minCrossingBodySize>
      </li>
    </modExtensions>
  </RimArt.EchoDef>

  <!-- Shirou: the way in is Origin: Blade (Melee 14, Crafting 12, five blades studied, then awakened),
       so the Trial is the trait itself. No forced trait: awakening Origin: Blade already cost psycasts
       and ranged weapons for life. His three magics (AG_Trace_Abilities.xml): Reinforcement (no charge),
       Trace On (copies of the blades he studied; Origin: Blade's study keeps filling its list after
       awakening) and Unlimited Blade Works, which also keeps its own 2-day cooldown. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Shirou</defName>
    <label>Shirou</label>
    <subtitle>The Faker</subtitle>
    <description>Every blade he has seen, he can make again.</description>
    <order>50</order>
    <trials>
      <li Class="RimArt.Trial_Trait">
        <trait>AG_OriginBlade</trait>
      </li>
    </trials>
    <abilities>
      <li>AG_Trace_Reinforcement</li>
      <li>AG_Trace_On</li>
      <li>AG_Trace_UnlimitedBladeWorks</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Shirou</manifestHediff>
    <upkeepPerHour>12</upkeepPerHour>
    <!-- Reinforcement costs no charge. -->
    <castCosts>
      <li>
        <ability>AG_Trace_On</ability>
        <cost>10</cost>
      </li>
      <li>
        <ability>AG_Trace_UnlimitedBladeWorks</ability>
        <cost>40</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.72, 0.3, 0.16)</hairColor>
  </RimArt.EchoDef>

  <!-- Itachi (docs/hero-echo.md, "Itachi"). The dispersal plexus is his Echo-only organ: given on
       awakening, kept for life, but Scatter, Crow Dispersal and Carrion work only in hero form. The
       crow abilities cost no charge (they spend the plexus's three charges); False Face and Susanoo
       cost charge. Sickly is vanilla Immunity at degree -1: his illness. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Itachi</defName>
    <label>Itachi</label>
    <subtitle>Crow of the Crimson Eye</subtitle>
    <description>He is never where the blow lands, and what looks at him sees what he chooses.</description>
    <order>60</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>12</level>
      </li>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>12</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>Kills</record>
        <count>30</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Immunity</trait>
        <degree>-1</degree>
      </li>
    </forcedTraits>
    <awakenGenes>
      <li MayRequire="Ludeon.RimWorld.Biotech">AG_DispersalPlexus</li>
    </awakenGenes>
    <abilities>
      <li>AG_DispersalMurder</li>
      <li>AG_DispersalCarrion</li>
      <li>AG_ItachiFalseFace</li>
      <li>AG_ItachiSusanoo</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Itachi</manifestHediff>
    <upkeepPerHour>10</upkeepPerHour>
    <castCosts>
      <li>
        <ability>AG_ItachiFalseFace</ability>
        <cost>3</cost>
      </li>
      <li>
        <ability>AG_ItachiSusanoo</ability>
        <cost>20</cost>
      </li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.08, 0.08, 0.1)</hairColor>
  </RimArt.EchoDef>

  <!-- Goku (docs/heroes.md): the four abilities are his own (AG_Goku_Abilities.xml); Warp Kamehameha
       is a button during the Kamehameha hold that spends Instant Transmission's cost and cooldown too.
       The downed-and-recovered Trial counts from the moment the mod is loaded. He fights with empty
       hands in hero form. Every number is a placeholder. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Goku</defName>
    <label>Goku</label>
    <subtitle>Heir of the Monkey King</subtitle>
    <description>He gets back up, and hits harder each time.</description>
    <order>70</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>15</level>
      </li>
      <li Class="RimArt.Trial_DownedRecovered">
        <count>3</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Gourmand</trait>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_GokuSolarFlare</li>
      <li>AG_GokuInstantTransmission</li>
      <li>AG_GokuKamehameha</li>
      <li>AG_GokuSpiritBomb</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Goku</manifestHediff>
    <emptyHands>true</emptyHands>
    <upkeepPerHour>12</upkeepPerHour>
    <castCosts>
      <li><ability>AG_GokuSolarFlare</ability><cost>3</cost></li>
      <li><ability>AG_GokuInstantTransmission</ability><cost>2</cost></li>
      <li><ability>AG_GokuKamehameha</ability><cost>15</cost></li>
      <li><ability>AG_GokuSpiritBomb</ability><cost>30</cost></li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.08, 0.08, 0.1)</hairColor>
  </RimArt.EchoDef>

  <!-- Todo (docs/hero-echo.md). The anchor organ is his Echo-only gene: given on awakening and kept for
       life, because his stones and his three claps live on it (a stone vanishes when no gene holds
       it). Stone, Clap, Double Clap and Black Flash work only in hero form; the stones stay on the
       map and the claps keep growing back between manifests. Provoke came from the Combat presence
       trait, which no longer grants it. Brawler is his cost; no subtitle. Every number is a placeholder. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Todo</defName>
    <label>Todo</label>
    <description>He claps, and whoever he chose is standing somewhere else.</description>
    <order>80</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>14</level>
      </li>
      <li Class="RimArt.Trial_Record">
        <record>PawnsDownedHumanlikes</record>
        <count>20</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Brawler</trait>
      </li>
    </forcedTraits>
    <awakenGenes>
      <li MayRequire="Ludeon.RimWorld.Biotech">AG_AnchorOrgan</li>
    </awakenGenes>
    <abilities>
      <li>AG_AnchorMark</li>
      <li>AG_AnchorClap</li>
      <li>AG_AnchorDoubleClap</li>
      <li>AG_AnchorBlackFlash</li>
      <li>AG_Provoke</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Todo</manifestHediff>
    <emptyHands>true</emptyHands>
    <upkeepPerHour>8</upkeepPerHour>
    <!-- Stone, Clap and Double Clap cost no charge: the three claps on the gene are their limit. -->
    <castCosts>
      <li><ability>AG_AnchorBlackFlash</ability><cost>1</cost></li>
      <li><ability>AG_Provoke</ability><cost>5</cost></li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.08, 0.08, 0.1)</hairColor>
  </RimArt.EchoDef>

  <!-- Minato (docs/hero-echo.md, docs/flying-thunder-god-kit.md). Throw kunai stays on the kunai belt the
       player equips (nothing is forced into his hands); every kunai he throws in hero form is his sealed
       kunai (KunaiSeal). Sealing touch is passive, on AG_MinatoSeal. The kill Trial counts thrown kunai
       (Projectile_Kunai names AG_Kunai as the weapon). No kunai regeneration. Every number is a placeholder. -->
  <RimArt.EchoDef ParentName="AG_EchoBase">
    <defName>AG_Echo_Minato</defName>
    <label>Minato</label>
    <subtitle>Hero of the Yellow Flash</subtitle>
    <description>Wherever his kunai lands, he is already there.</description>
    <order>90</order>
    <trials>
      <li Class="RimArt.Trial_Skill">
        <skill>Melee</skill>
        <level>12</level>
      </li>
      <li Class="RimArt.Trial_Skill">
        <skill>Intellectual</skill>
        <level>10</level>
      </li>
      <li Class="RimArt.Trial_KillsWith">
        <weapons>
          <li>AG_Kunai</li>
        </weapons>
        <weaponLabel>thrown kunai</weaponLabel>
        <count>30</count>
      </li>
    </trials>
    <forcedTraits>
      <li>
        <trait>Kind</trait>
      </li>
    </forcedTraits>
    <abilities>
      <li>AG_ThunderGodJump</li>
      <li>AG_ThunderGodChain</li>
      <li>AG_GuidingThunder</li>
      <li>AG_Rasengan</li>
    </abilities>
    <manifestHediff>AG_EchoManifest_Minato</manifestHediff>
    <upkeepPerHour>10</upkeepPerHour>
    <castCosts>
      <li><ability>AG_ThunderGodJump</ability><cost>2</cost></li>
      <li><ability>AG_ThunderGodChain</ability><cost>10</cost></li>
      <li><ability>AG_GuidingThunder</ability><cost>5</cost></li>
      <li><ability>AG_Rasengan</ability><cost>3</cost></li>
    </castCosts>
    <wealth>6000</wealth>
    <hairColor>(0.96, 0.83, 0.36)</hairColor>
  </RimArt.EchoDef>

</Defs>
