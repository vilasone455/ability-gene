    <techLevel>Neolithic</techLevel>
    <prerequisites>
      <li>ComplexFurniture</li>
    </prerequisites>
    <researchViewX>7.00</researchViewX>
    <researchViewY>13.80</researchViewY>
  </ResearchProjectDef>

</Defs>
