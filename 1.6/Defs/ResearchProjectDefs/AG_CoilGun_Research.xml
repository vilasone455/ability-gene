<Defs>

  <!-- The Coil Gun kit: magnetic coils, a battery and plasteel rails, so industrial and after
       microelectronics. It sits at 11.00/6.00, in the vanilla column right of Microelectronics
       (10.00/3.00), below Standard mechtech (11.00/5.40), which is the last vanilla project in that
       column. This mod's own column (7.00 and 8.00) is left to the other kit weapons. Not checked
       against other mods' projects in the research tab. -->
  <ResearchProjectDef>
    <defName>AG_CoilGun</defName>
    <label>coil gun</label>
    <description>Make coil guns: a rifle that fires electric bolts, strong against mechanoids, and can throw a bolt of lightning that jumps between enemies. Its battery recharges from the colony's batteries.</description>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>MicroelectronicsBasics</li>
    </prerequisites>
    <researchViewX>11.00</researchViewX>
    <researchViewY>6.00</researchViewY>
  </ResearchProjectDef>

</Defs>
