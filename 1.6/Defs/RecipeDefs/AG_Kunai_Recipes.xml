<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 25 steel into 5 kunai. A RecipeDef rather than a recipeMaker on AG_Kunai so the batch
       size is stated in products. -->
  <RecipeDef>
    <defName>AG_MakeKunai</defName>
    <label>make kunai x5</label>
    <description>Make 5 kunai from 25 steel.</description>
    <jobString>Making kunai.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>1600</workAmount>
    <researchPrerequisite>Smithing</researchPrerequisite>
    <recipeUsers>
      <li>FueledSmithy</li>
      <li>ElectricSmithy</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <AG_Kunai>5</AG_Kunai>
    </products>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <displayPriority>331</displayPriority>
  </RecipeDef>

  <!-- Surgery to take a stuck kunai out without the pull's extra cut. One per operation, per
       body part. Recipe_RemoveHediff removes the hediff, whose PostRemoved drops the kunai item
       next to the patient. -->
  <RecipeDef ParentName="SurgeryFlesh">
    <defName>AG_RemoveEmbeddedKunai</defName>
    <label>remove embedded kunai</label>
    <description>Remove a kunai stuck in a body part. Unlike pulling it out by hand, this does not cut the part further. The kunai is dropped next to the patient.</description>
    <workerClass>Recipe_RemoveHediff</workerClass>
    <jobString>Removing embedded kunai.</jobString>
    <workAmount>1000</workAmount>
    <isViolation>false</isViolation>
    <targetsBodyPart>true</targetsBodyPart>
    <removesHediff>AG_EmbeddedKunai</removesHediff>
    <successfullyRemovedHediffMessage>{0} has removed the kunai stuck in {1}.</successfullyRemovedHediffMessage>
    <skillRequirements>
      <Medicine>3</Medicine>
    </skillRequirements>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

</Defs>
