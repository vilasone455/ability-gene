<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Behind AG_Vacuum. A RecipeDef rather than a recipeMaker, as the water gun's is. Proposed cost:
       steel for the wand and the canister, cloth for the hose, two components for the motor. -->
  <RecipeDef>
    <defName>AG_MakeVacuum</defName>
    <label>make vacuum</label>
    <description>Make a vacuum from 60 steel, 15 cloth and 2 components. It comes empty.</description>
    <jobString>Making a vacuum.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>5000</workAmount>
    <researchPrerequisite>AG_Vacuum</researchPrerequisite>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>60</count>
      </li>
      <li>
        <filter><thingDefs><li>Cloth</li></thingDefs></filter>
        <count>15</count>
      </li>
      <li>
        <filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Cloth</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <AG_Vacuum>1</AG_Vacuum>
    </products>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
  </RecipeDef>

</Defs>
