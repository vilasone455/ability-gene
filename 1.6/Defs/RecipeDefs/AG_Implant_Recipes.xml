<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Each of these consumes the device it installs, plus medicine.
       SurgeryInstallImplantBase supplies medicine alone, so inheriting it without an
       ingredients override made every implant here free: two herbal poultices and a
       doctor bought an archotech phase barrier, repeatably, from day one. The items are
       defined in ThingDefs/AG_Implant_Things.xml. -->

  <!-- Pain Inhibitor — brain implant, industrial tier -->
  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>AG_InstallPainInhibitor</defName>
    <label>install pain inhibitor</label>
    <description>Install a pain inhibitor implant in the brain.</description>
    <jobString>Installing pain inhibitor.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>AG_PainInhibitor</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter><categories><li>Medicine</li></categories></filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>AG_PainInhibitor</li>
      </thingDefs>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
    <addsHediff>AG_PainInhibitor</addsHediff>
    <appliedOnFixedBodyParts>
      <li>Brain</li>
    </appliedOnFixedBodyParts>
  </RecipeDef>

