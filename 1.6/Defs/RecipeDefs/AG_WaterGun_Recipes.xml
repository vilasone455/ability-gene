<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Behind AG_WaterGun. A RecipeDef rather than a recipeMaker, as the tag scroll's is. Proposed
       cost: steel for the gun and pump, cloth for the bag and hose, one component for the valve. -->
  <RecipeDef>
    <defName>AG_MakeWaterGun</defName>
    <label>make water gun</label>
    <description>Make a water gun and its water bag from 40 steel, 20 cloth and 1 component. It comes with a full bag.</description>
    <jobString>Making a water gun.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>4000</workAmount>
    <researchPrerequisite>AG_WaterGun</researchPrerequisite>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>40</count>
      </li>
      <li>
        <filter><thingDefs><li>Cloth</li></thingDefs></filter>
        <count>20</count>
      </li>
      <li>
        <filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Cloth</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <AG_WaterGun>1</AG_WaterGun>
    </products>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
  </RecipeDef>

</Defs>
