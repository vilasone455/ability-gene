<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- A Biotech-free copy of Biotech's CastAbilityOnThingWithoutWeapon.

       The abilities in this mod are shared across sources: the same cast that a gene grants
       is also granted by a trait, an implant hediff or a weapon trait. Pointing their
       <jobDef> at a Biotech def meant that every one of them failed cross-reference
       resolution without Biotech installed, including the ones no gene is involved in.
       The gene defs can be MayRequire'd away; these abilities cannot, because they have to
       survive for the sources that are not genes.

       The parent CastAbilityOnThing is Core, and supplies driverClass JobDriver_CastAbility.
       Only the two fields Biotech overrides are restated here. -->
  <JobDef ParentName="CastAbilityOnThing">
    <defName>AG_CastAbilityOnThingWithoutWeapon</defName>
    <neverShowWeapon>true</neverShowWeapon>
    <playerInterruptible>false</playerInterruptible>
  </JobDef>

  <!-- The Anchor organ's clap and double clap. Same two fields, plus a driver that plays the clap
       clip over the warmup and holds the job until the clip's open-hands pose is done. The clip is
       tied to this job def: Melee Animation cancels a clip whose pawn is in any other job. -->
  <JobDef ParentName="CastAbilityOnThing">
    <defName>AG_CastAnchorClap</defName>
    <driverClass>RimArt.JobDriver_CastClap</driverClass>
    <neverShowWeapon>true</neverShowWeapon>
    <playerInterruptible>false</playerInterruptible>
  </JobDef>

  <!-- The Anchor organ's Mark. The same again, with the driver that plays the card flick, or the
       catch when the target is already marked, over the warmup. -->
  <JobDef ParentName="CastAbilityOnThing">
    <defName>AG_CastAnchorMark</defName>
    <driverClass>RimArt.JobDriver_CastMark</driverClass>
    <neverShowWeapon>true</neverShowWeapon>
    <playerInterruptible>false</playerInterruptible>
  </JobDef>

  <!-- The Power Pole's three abilities. The driver tells the picture the cast has begun when the
       warmup starts, and holds the job until the pole is back to its carried length. The weapon is
       hidden for the job because the picture draws the pole. -->
  <JobDef ParentName="CastAbilityOnThing">
    <defName>AG_CastPowerPole</defName>
    <driverClass>RimArt.JobDriver_CastPowerPole</driverClass>
    <neverShowWeapon>true</neverShowWeapon>
    <playerInterruptible>false</playerInterruptible>
  </JobDef>

  <!-- After a Vault Strike lands the pole is still pinned on the target and then retracts, 0.4 s
       in all. The wielder stands for that long. Core's Wait driver with an expiry; the player
       cannot interrupt it, so a move order given during it starts when it ends. -->
  <JobDef>
    <defName>AG_PowerPoleRecover</defName>
    <driverClass>JobDriver_Wait</driverClass>
    <reportString>recovering the pole.</reportString>
    <playerInterruptible>false</playerInterruptible>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    <neverShowWeapon>true</neverShowWeapon>
  </JobDef>

  <!-- Tag Throw, Tag Line and Paper Shroud. The driver starts the ability's clip with the warmup and
       holds the job until the clip ends. The weapon is hidden for the job because the clip draws the
       scroll in the off hand. -->
  <JobDef ParentName="CastAbilityOnThing">
    <defName>AG_CastPaperBomb</defName>
    <driverClass>RimArt.JobDriver_CastPaperBomb</driverClass>
    <neverShowWeapon>true</neverShowWeapon>
    <playerInterruptible>false</playerInterruptible>
  </JobDef>

</Defs>
