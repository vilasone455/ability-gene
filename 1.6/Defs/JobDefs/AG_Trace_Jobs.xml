<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Unlimited Blade Works' chant: the caster stands until the cast takes it into the world. A move order
       ends the job and with it the chant (the cooldown comes back). -->
  <JobDef>
    <defName>AG_UbwChant</defName>
    <driverClass>RimArt.JobDriver_UbwChant</driverClass>
    <reportString>Chanting.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

  <!-- The cast job of Trace On and Reinforcement (RimArt.JobDriver_CastTrace): starts the picture with the job,
       lets Trace On put away what the hand holds before the warmup, and holds the pawn a moment after the fire.
       alwaysShowWeapon: an undrafted caster shows the weapon the picture is drawn on. -->
  <JobDef ParentName="CastAbilityOnThing">
    <defName>AG_CastTrace</defName>
    <driverClass>RimArt.JobDriver_CastTrace</driverClass>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>
</Defs>
