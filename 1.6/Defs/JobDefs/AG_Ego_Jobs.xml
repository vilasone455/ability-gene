<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- A corroded pawn stands (MentalState_EgoCorroded.cs): 2 s at a time, asked again by the think tree. -->
  <JobDef>
    <defName>AG_EgoCorrodedHold</defName>
    <driverClass>RimArt.JobDriver_EgoCorrodedHold</driverClass>
    <reportString>corroded.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

  <!-- Overclock (JobDriver_EgoOverclock.cs): stand and fire the weapon's corroded attack at hostiles. -->
  <JobDef>
    <defName>AG_EgoOverclock</defName>
    <driverClass>RimArt.JobDriver_EgoOverclock</driverClass>
    <reportString>overclocking.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

</Defs>
