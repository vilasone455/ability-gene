<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Inumaki's words (docs/hero-echo.md, "Inumaki revisit"). Six AbilityDefs, one comp class; the
       word field picks what it does. Only Inumaki's Echo grants them.

       A word has no target: it is cast on Inumaki himself and spreads from his cell as a sound
       (SoundSpread.cs). Reach comes from the volume on his hero form (whisper 3, speak 8, shout 16;
       LarynxExtension on AG_LarynxWear), not from the verb, so the verb range only has to cover
       his own cell. The only cost is throat wear: throatCost x volume factor x each listener's
       factor, summed. Every number is a placeholder. -->
  <AbilityDef Name="AG_ImperativeBase" Abstract="True">
    <category>AG_Genetic</category>
    <aiCanUse>false</aiCanUse>
    <hostile>true</hostile>
    <targetRequired>false</targetRequired>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <showCastingProgressBar>true</showCastingProgressBar>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0.9</range>
      <warmupTime>0.4</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <AbilityDef ParentName="AG_ImperativeBase">
    <defName>AG_Imperative_Stop</defName>
    <label>stop</label>
    <description>Everyone who hears it stands still for 3 seconds, then goes back to what they were doing. They keep their weapon and target.\n\nThroat: 3 % per listener at speak volume.</description>
    <iconPath>UI/Abilities/AnimalWarcall</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <comps>
      <li Class="RimArt.CompProperties_AbilityImperative">
        <word>Stop</word>
        <throatCost>0.03</throatCost>
        <holdTicks>180</holdTicks>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="AG_ImperativeBase">
    <defName>AG_Imperative_Drop</defName>
    <label>drop</label>
    <description>Everyone who hears it and holds a weapon stops and drops it at their feet (about half a second). They can pick it back up.\n\nThroat: 5.5 % per listener at speak volume. Unarmed pawns do not count.</description>
    <iconPath>UI/Abilities/AnimalWarcall</iconPath>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <comps>
      <li Class="RimArt.CompProperties_AbilityImperative">
        <word>Drop</word>
        <throatCost>0.055</throatCost>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="AG_ImperativeBase">
    <defName>AG_Imperative_Crush</defName>
    <label>crush</label>
    <description>Everyone who hears it takes 15 blunt damage and is stunned for 1 second.\n\nThroat: 9 % per listener at speak volume.</description>
    <iconPath>UI/Abilities/AnimalWarcall</iconPath>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <comps>
      <li Class="RimArt.CompProperties_AbilityImperative">
        <word>Crush</word>
        <throatCost>0.09</throatCost>
        <damage>15</damage>
        <armorPenetration>0.3</armorPenetration>
        <stunTicks>60</stunTicks>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="AG_ImperativeBase">
    <defName>AG_Imperative_Come</defName>
    <label>come</label>
    <description>Everyone who hears it walks to Inumaki, then goes back to what they were doing.\n\nThroat: 7 % per listener at speak volume.</description>
    <iconPath>UI/Abilities/AnimalWarcall</iconPath>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <comps>
      <li Class="RimArt.CompProperties_AbilityImperative">
        <word>Come</word>
        <throatCost>0.07</throatCost>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="AG_ImperativeBase">
    <defName>AG_Imperative_Run</defName>
    <label>run</label>
    <description>Everyone who hears it runs up to 24 cells away from Inumaki, then goes back to what they were doing.\n\nThroat: 9 % per listener at speak volume.</description>
    <iconPath>UI/Abilities/AnimalWarcall</iconPath>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <comps>
      <li Class="RimArt.CompProperties_AbilityImperative">
        <word>Run</word>
        <throatCost>0.09</throatCost>
        <fleeDistance>24</fleeDistance>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="AG_ImperativeBase">
    <defName>AG_Imperative_Explode</defName>
    <label>explode</label>
    <description>An explosion goes off on everyone who hears it: 35 bomb damage in radius 1.5. It also hits anyone standing next to a listener, allies included, but not Inumaki.\n\nThroat: 35 % per listener at speak volume. Cooldown 1 day.</description>
    <iconPath>UI/Abilities/AnimalWarcall</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <comps>
      <li Class="RimArt.CompProperties_AbilityImperative">
        <word>Explode</word>
        <throatCost>0.35</throatCost>
        <damage>35</damage>
        <burstRadius>1.5</burstRadius>
      </li>
    </comps>
  </AbilityDef>

</Defs>
