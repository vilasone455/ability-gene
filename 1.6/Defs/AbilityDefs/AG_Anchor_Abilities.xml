<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Marking is the expensive half. The short range is the cost: you have to have been next to
       the thing you intend to move, so the clap is a plan you made earlier rather than an answer
       to what is currently happening. -->
  <AbilityDef>
    <defName>AG_AnchorMark</defName>
    <label>mark</label>
    <description>Leave a mark on a person, an animal or a patch of ground, and it stays with them wherever they go. The carrier holds three at once, and marking something already marked takes that mark back instead.\n\nMarks fade after about a day, and placing one means walking close enough to touch.</description>
    <iconPath>UI/Gizmos/RemoteRepair</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>600</cooldownTicksRange>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9.9</range>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityMark" />
    </comps>
  </AbilityDef>

  <!-- Range is deliberately map-wide and sightless. Distance is the thing the gene does not
       care about; getting there in the first place is. -->
  <AbilityDef>
    <defName>AG_AnchorClap</defName>
    <label>clap</label>
    <description>Clap once and change places with one of your marks, at any distance and without line of sight. A mark on someone is a straight swap; a mark on the ground simply moves the carrier there.\n\nThe mark is spent, and both hands have to be empty.</description>
    <iconPath>UI/Icons/Genes/Gene_HandsHuman</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <jobDef>AG_CastAnchorClap</jobDef>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9999</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityClap" />
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Manipulation</capacity>
      </li>
    </comps>
  </AbilityDef>

  <!-- Two selected targets, the same shape as the Skip psycast: pick a thing, then pick where.
       Here both picks have to be marks the carrier is already holding. -->
  <AbilityDef>
    <defName>AG_AnchorDoubleClap</defName>
    <label>double clap</label>
    <description>Clap twice and any two of your marks change places with each other. The carrier does not move and is not one of the ends - this is how a raider ends up in your killbox without anyone standing in it.\n\nBoth marks are spent, at least one must be on something that can move, and both hands have to be empty.</description>
    <iconPath>UI/Icons/Genes/Gene_LongJumpLegs</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <jobDef>AG_CastAnchorClap</jobDef>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9999</range>
      <warmupTime>0.75</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityDoubleClap">
        <destination>Selected</destination>
        <range>9999</range>
        <requiresLineOfSight>false</requiresLineOfSight>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Manipulation</capacity>
      </li>
    </comps>
  </AbilityDef>

</Defs>
