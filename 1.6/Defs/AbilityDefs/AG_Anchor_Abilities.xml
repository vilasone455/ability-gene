<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Mark throws a stone onto a tile. Pawns in sight need no stone, so this never targets a
       pawn: the stone is for places and for anyone who will be out of sight or out of range. -->
  <AbilityDef>
    <defName>AG_AnchorMark</defName>
    <label>mark</label>
    <description>Throw a stone onto a patch of ground. A clap can reach the stone from anywhere on the map, without line of sight. Up to three stones at once; throwing at one of your own stones takes it back.\n\nStones fade after about a day. They lie on the ground forbidden, so nobody hauls them away.</description>
    <iconPath>UI/Gizmos/RemoteRepair</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>600</cooldownTicksRange>
    <jobDef>AG_CastAnchorMark</jobDef>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9.9</range>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityMark" />
    </comps>
  </AbilityDef>

  <!-- The verb's range is map-wide and sightless because a stone can be anywhere. Pawns without
       a stone are held to directSwapRange and line of sight by the comp, and every clap is paid
       from the gene's shared charges (AG_Anchor_Gene.xml), so there is no cooldown here. -->
  <AbilityDef>
    <defName>AG_AnchorClap</defName>
    <label>clap</label>
    <description>Clap once and change places with a living person or animal in sight within 15 cells, or with one of your stones anywhere on the map. A stone lands where you stood, so a second clap brings you back. A hostile that is swapped loses track of where it is for a moment.\n\nUses one of three claps, which grow back one every 10 seconds. A stone more than 25 cells away needs all three and is used up. Both hands have to be empty.</description>
    <iconPath>UI/Icons/Genes/Gene_HandsHuman</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>0</cooldownTicksRange>
    <jobDef>AG_CastAnchorClap</jobDef>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9999</range>
      <warmupTime>0.3</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityClap" />
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Manipulation</capacity>
      </li>
    </comps>
  </AbilityDef>

  <!-- Two selected targets, the same shape as the Skip psycast: pick a thing, then pick where.
       Each pick is a pawn in sight within directSwapRange or one of the carrier's stones. -->
  <AbilityDef>
    <defName>AG_AnchorDoubleClap</defName>
    <label>double clap</label>
    <description>Clap twice and two others change places: people or animals in sight within 15 cells, or your stones anywhere on the map. The carrier does not move - this is how a raider ends up in your killbox without anyone standing in it.\n\nAt least one end has to be a person or animal. Uses one of the three shared claps; a stone more than 25 cells away needs all three and is used up. Both hands have to be empty.</description>
    <iconPath>UI/Icons/Genes/Gene_LongJumpLegs</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>0</cooldownTicksRange>
    <jobDef>AG_CastAnchorClap</jobDef>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9999</range>
      <warmupTime>0.5</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityDoubleClap">
        <destination>Selected</destination>
        <range>9999</range>
        <requiresLineOfSight>false</requiresLineOfSight>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Manipulation</capacity>
      </li>
    </comps>
  </AbilityDef>

</Defs>
