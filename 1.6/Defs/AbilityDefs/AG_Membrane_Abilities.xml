<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Gojo's Infinity (granted only by AG_Echo_Gojo since the Gojo port; the phase barrier implant grants nothing).
       Self-cast: the field sits on his own surface, so there is nothing to aim at. The cooldown is short on
       purpose: the real limit is how long he can hold his breath, which lives on the hediff's Breathing ramp.
       The field numbers are on HediffCompProperties_Recursion in HediffDefs/AG_Membrane_Hediffs.xml. -->
  <AbilityDef>
    <defName>AG_Recursion</defName>
    <label>Infinity</label>
    <description>Raise Infinity. Everything moving toward Gojo within 3.9 cells keeps halving the distance it has left and never arrives: a bullet or arrow hangs in the air and halves its gap every 6 seconds; a melee attacker's chance to connect halves every second; explosions, fire and other damage with no attacker behind it are cut to 15%.\n\nIt holds back air too, so Gojo stops breathing while it is up: after 14 seconds his breathing and consciousness start to drop, at about 32 seconds he usually goes down, and at 39 seconds he dies. Drop Infinity from its own button; every held round and blow resumes at once. Costs no charge. Cooldown 1 hour.</description>
    <iconPath>UI/Abilities/MechSmokepop</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <jobDef>AG_CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_Recursion</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Consciousness</capacity>
      </li>
    </comps>
  </AbilityDef>

</Defs>
