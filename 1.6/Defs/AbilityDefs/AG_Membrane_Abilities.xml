<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Self-cast. The membrane sits on the carrier's own surface, so there is nothing to aim at.
       The cooldown is short on purpose: the real limit is how long a person can hold their
       breath, which lives on the hediff's Breathing ramp, not here. -->
  <AbilityDef>
    <defName>AG_Recursion</defName>
    <label>phase guard</label>
    <description>Hold the membrane open, and everything moving toward the carrier begins halving the distance it has left without ever finishing - rounds hang short, blows miss by margins that keep doubling.\n\nAir is approaching too, so the carrier stops breathing until it closes. Nothing has been destroyed: everything still on its way lands the instant it does.</description>
    <iconPath>UI/Abilities/MechSmokepop</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <jobDef>AG_CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_Recursion</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Consciousness</capacity>
      </li>
    </comps>
  </AbilityDef>

</Defs>
