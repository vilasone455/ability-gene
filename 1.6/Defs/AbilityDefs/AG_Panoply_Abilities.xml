<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Three abilities, and only the first of them makes anything. Loose and grasp are both
       readers of what rain left on the ground, which is why neither has a resource, a charge
       or a magazine: the ammunition is the field, and the field is visible. -->

  <AbilityDef>
    <defName>AG_Panoply_Rain</defName>
    <label>rain</label>
    <description>Call a rain of blades over a chosen place. The first impact matters less than the field of planted blades left behind for Loose and Grasp.\n\nMaintaining the scattered arsenal burdens its origin until the blades are spent or reclaimed.</description>
    <iconPath>RimArt/Panoply/IconRain</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>30000</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <hostile>true</hostile>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>26.9</range>
      <warmupTime>1.5</warmupTime>
      <drawAimPie>true</drawAimPie>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityBladeRain">
        <radius>6.9</radius>
        <bladeCount>14</bladeCount>
        <impactDamage>12</impactDamage>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>AG_Panoply_Loose</defName>
    <label>loose</label>
    <description>Every blade standing near the chosen point lifts, turns to face it and goes. Each flies from the cell it happens to be in, so the volley keeps the shape the rain left - blades on the wrong side of a wall spend themselves on the wall.\n\nThey do not come back; wherever each one stops is where it is standing now.</description>
    <iconPath>RimArt/Panoply/IconLoose</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>900</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <hostile>true</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>26.9</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawAimPie>true</drawAimPie>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>true</canTargetMechs>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityBladeLoose">
        <radius>12.9</radius>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>AG_Panoply_Grasp</defName>
    <label>grasp</label>
    <description>The nearest planted blade tears out of the ground and flies to an open hand - the origin's own, or anyone else's within sight. It becomes an ordinary steel longsword and remains in the world.\n\nThe hand must be empty; the ability will not drop another weapon to make room.</description>
    <iconPath>RimArt/Panoply/IconGrasp</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>600</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <hostile>false</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>24.9</range>
      <warmupTime>0.4</warmupTime>
      <drawAimPie>true</drawAimPie>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityBladeGrasp" />
    </comps>
  </AbilityDef>

</Defs>
