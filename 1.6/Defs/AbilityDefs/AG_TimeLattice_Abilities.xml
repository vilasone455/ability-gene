<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- All three are self-cast and target nothing. The lattice acts on one body only;
       nothing around the carrier changes rate. -->
  <AbilityDef Name="AG_TimeAlterAbilityBase" Abstract="True">
    <category>AG_Genetic</category>
    <jobDef>AG_CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <AbilityDef ParentName="AG_TimeAlterAbilityBase">
    <defName>AG_TimeAlterDouble</defName>
    <label>time alter: double accel</label>
    <description>Run the neural accelerator at twice normal rate for 20 seconds - fast enough to cross open ground before a volley lands, or to finish a melee before it starts properly.\n\nThe strain heals off over about three days, so this setting can be used regularly, but repeated use still stacks.</description>
    <iconPath>UI/Icons/Genes/Gene_QuickMovespeed</iconPath>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_TimeAlterDouble</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Consciousness</capacity>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="AG_TimeAlterAbilityBase">
    <defName>AG_TimeAlterSquare</defName>
    <label>time alter: square accel</label>
    <description>Run the neural accelerator at four times normal rate for six seconds - enough to cross a killzone, reach a downed colonist, or end a fight outright.\n\nOne full use pushes strain close to critical, where the acceleration begins leaving damage that never heals.</description>
    <iconPath>UI/Abilities/MechLongJump</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_TimeAlterSquare</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Consciousness</capacity>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef ParentName="AG_TimeAlterAbilityBase">
    <defName>AG_TimeAlterStagnate</defName>
    <label>time alter: stagnate</label>
    <description>Run the neural accelerator in reverse at a third of normal rate for a full minute. The carrier can barely act, but blood loss, infection and poison slow by the same factor.\n\nSlowing down causes no temporal strain.</description>
    <iconPath>UI/Icons/Genes/Gene_SlowMovespeed</iconPath>
    <cooldownTicksRange>15000</cooldownTicksRange>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_TimeAlterStagnate</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
    </comps>
  </AbilityDef>

</Defs>
