<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityCategoryDef>
    <defName>AG_Genetic</defName>
    <label>genetic</label>
    <displayOrder>900</displayOrder>
  </AbilityCategoryDef>

  <AbilityDef>
    <defName>AG_DisarmSpit</defName>
    <label>disarm spit</label>
    <description>Spit a glob of contact-acid at whatever the target is holding. The acid eats through a sling, a stock or a set of fingers well enough to make them let go, and the weapon lands out of easy reach.\n\nThe target is otherwise unharmed, which is the point — this takes a threat off the field without taking the body off it.</description>
    <iconPath>UI/Abilities/AcidSpray</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>20000</cooldownTicksRange>
    <charges>2</charges>
    <cooldownPerCharge>true</cooldownPerCharge>
    <aiCanUse>true</aiCanUse>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <warmupStartSound>AcidSpray_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>12.9</range>
      <warmupTime>1</warmupTime>
      <soundCast>AcidSpray_Resolve</soundCast>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityDisarm">
        <scatterRadius>3</scatterRadius>
        <forbidDropped>true</forbidDropped>
        <goodwillImpact>-15</goodwillImpact>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>AcidSpray</fleckDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>AG_MetabolicOverdrive</defName>
    <label>metabolic overdrive</label>
    <description>Unclamp the carrier's metabolic governor. Wounds close at a rate you can watch, paid for directly out of the body's food reserves.\n\nIt runs until the wounds are gone or the reserves are — so using it on a badly mangled colonist will leave them starving.</description>
    <iconPath>UI/Abilities/FireBurst</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <statBases>
      <Ability_Duration>120</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <warmupTime>1</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_MetabolicOverdrive</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>BloodPumping</capacity>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>AG_Provoke</defName>
    <label>provoke</label>
    <description>Flood the surrounding air with alarm pheromones keyed to read as the single most urgent threat present. Every hostile close enough to smell it drops what it was doing and comes for the carrier.\n\nThe carrier's skin tightens in the same reflex, turning aside some of what follows. It is not enough to make this safe.</description>
    <iconPath>UI/Icons/Genes/Gene_VoiceRoar</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>30000</cooldownTicksRange>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <aiCanUse>false</aiCanUse>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <statBases>
      <Ability_Duration>20</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <warmupTime>0.5</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_Provoking</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>AG_TimeBubble</defName>
    <label>stasis field</label>
    <description>Collapse a sphere of stopped time around the carrier. Inside it nothing moves, nothing burns, nothing bleeds and bullets hang in the air where they were.\n\nThe field does not know friend from enemy and it does not spare the person who cast it. Everyone inside — raiders, your own people, the carrier — is simply gone from the fight until it lifts. Nothing inside can be harmed while it holds.\n\nWhat you buy is time for everyone standing outside it.</description>
    <iconPath>UI/Abilities/Resurrect</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>300000</cooldownTicksRange>
    <jobDef>CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <aiCanUse>false</aiCanUse>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <warmupTime>1</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityTimeBubble">
        <radius>6.9</radius>
        <durationTicks>1200</durationTicks>
        <frozenAreInvulnerable>true</frozenAreInvulnerable>
        <!-- Vanilla force fields (bullet shield, mech shields) are grey (0.4, 0.4, 0.4)
             and idle near alpha 0.2. Off-white with a blue bias reads as ice instead,
             and stays distinguishable from a bullet shield at a glance. -->
        <domeColor>(0.75, 0.90, 1.0, 0.40)</domeColor>
      </li>
    </comps>
  </AbilityDef>

</Defs>
