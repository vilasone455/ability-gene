<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Deliberate flight, sharing charges with the toggleable automatic Scatter.

       requireLineOfSight is false on purpose, and it is the whole reason this is not the anchor
       organ's clap or the Arcing weapon's dash wearing feathers. Those two cross a distance; this
       one crosses whatever is in the way. A wall, a river, a burning room, a line of raiders -
       none of it is on the route, because for the length of the flight there is nobody on the
       route to be stopped by any of it.

       What it cannot do is land somewhere a person cannot stand. JumpUtility.ValidJumpTarget
       decides that, the same as it does for Core's longjump, and it also rules out fog - so this
       is not a way to drop a colonist into unexplored map. -->
  <AbilityDef>
    <defName>AG_DispersalMurder</defName>
    <label>murder</label>
    <description>Disperse into a flock of crows and fly up to 35 cells to a chosen spot, crossing walls, water, fire and enemies without line of sight. The destination must be revealed and able to hold a standing pawn.\n\nThe carrier lands ready to act, for one of the plexus's three shared charges.</description>
    <iconPath>RimArt/Dispersal/IconGene</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayOrder>250</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <label>murder</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.2</warmupTime>
      <range>34.9</range>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityMurder" />
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>AG_DispersalCarrion</defName>
    <label>carrion</label>
    <description>Send a flock of crows to strip a fresh corpse within 10 cells, then carry back what they took. Bleeding closes, lost blood returns, and a carrier with a Hemogen reserve refills part of it.\n\nThe corpse is consumed along with one charge, and only one flock can be feeding at a time.</description>
    <iconPath>RimArt/Dispersal/IconCarrion</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayOrder>251</displayOrder>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <label>carrion</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.2</warmupTime>
      <range>10</range>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetCorpses>true</canTargetCorpses>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityCarrion" />
    </comps>
  </AbilityDef>

</Defs>
