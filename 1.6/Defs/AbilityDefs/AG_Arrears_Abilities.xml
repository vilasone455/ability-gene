<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Self-cast. The plexus sits between the carrier and their own body, so there is nothing to
       aim at. Castable by a pawn incapable of violence on purpose - taking a beating without
       telling anyone is not a violent act, and a doctor crossing open ground is exactly who
       wants this. -->
  <AbilityDef>
    <defName>AG_Arrears</defName>
    <label>wound debt</label>
    <description>Stop reporting. For twenty seconds every wound the carrier takes is written down instead of applied - no damage, no bleeding, no pain, no going down.\n\nNone of it is prevented: when the time runs out every wound lands at once, in a single instant, which is why the carrier's gizmo can settle the debt early and in cover.</description>
    <iconPath>UI/Abilities/MechResurrection</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>30000</cooldownTicksRange>
    <jobDef>AG_CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_Arrears</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Consciousness</capacity>
      </li>
    </comps>
  </AbilityDef>

</Defs>
