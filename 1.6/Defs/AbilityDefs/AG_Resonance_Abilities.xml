<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Self-cast: the note is set in the carrier's own frame, so there is nothing to aim at.
       Unlike the other self-buffs in this mod, casting this requires a pawn capable of
       violence - it does nothing at all except through a melee weapon or a fist, so offering
       it to a pacifist would be offering them an empty button. -->
  <AbilityDef>
    <defName>AG_Resonance</defName>
    <label>resonance</label>
    <description>Set the weapon ringing for thirty seconds: every melee blow leaves the struck part resonating for about five seconds, and a second blow on the same part takes it off the body. Only limbs and extremities can hold the note.\n\nThe resonance passes through the weapon into its wielder, leaving their own frame vulnerable on the same terms.</description>
    <iconPath>UI/Abilities/PiercingSpine</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <jobDef>AG_CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_Resonance</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Consciousness</capacity>
      </li>
    </comps>
  </AbilityDef>

</Defs>
