<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Self-cast: the reflex acts on the carrier's own surface, so there is nothing to aim at. -->
  <AbilityDef>
    <defName>AG_VectorReflection</defName>
    <label>reflection</label>
    <description>Open the reflex all the way for thirty seconds. Every vector arriving at the carrier is reversed - bullets sent back down their own line, blows returned to whoever swung them, a fire on them turned on itself.\n\nThe carrier is rooted in place while it holds, and nobody can reach them for any reason: no tending, no feeding, no rescue.</description>
    <iconPath>UI/Gizmos/ShieldMech</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <jobDef>AG_CastAbilityOnThingWithoutWeapon</jobDef>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <sendMessageOnCooldownComplete>true</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>AG_VectorReflection</hediffDef>
        <onlyApplyToSelf>true</onlyApplyToSelf>
      </li>
      <li Class="CompProperties_AbilityRequiresCapacity">
        <capacity>Consciousness</capacity>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>AG_VectorShove</defName>
    <label>vector shove</label>
    <description>Take hold of one body's momentum and spend all of it throwing them away from the carrier. Damage scales with the distance travelled, and a great deal more if something solid stops them early.\n\nHeavier bodies move less; this is for breaking a melee grip and introducing people to walls, not for damage.</description>
    <iconPath>UI/Abilities/Longjump</iconPath>
    <category>AG_Genetic</category>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>12.9</range>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetMechs>true</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="RimArt.CompProperties_AbilityVectorShove">
        <pushCells>6</pushCells>
        <stunTicks>60</stunTicks>
        <damagePerCell>1.5</damagePerCell>
        <slamDamage>8</slamDamage>
        <scaleByBodySize>true</scaleByBodySize>
        <goodwillImpact>-15</goodwillImpact>
      </li>
    </comps>
  </AbilityDef>

</Defs>
