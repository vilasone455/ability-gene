<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Retired 2026-09-28: Provoke is Todo's now (AG_Echo_Todo). The def stays so a save whose pawns
       have the trait still loads; commonality 0 keeps it off new pawns and it grants nothing. -->
  <TraitDef>
    <defName>AG_CombatPresence</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>combat presence</label>
        <description>This person commands attention on the battlefield. Hostiles find it hard to ignore them.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
    <conflictingTraits>
      <li>Wimp</li>
    </conflictingTraits>
  </TraitDef>

  <!-- Pain Debt is the sole source of Wound Debt. -->
  <TraitDef>
    <defName>AG_PainDebt</defName>
    <commonality>0.3</commonality>
    <degreeDatas>
      <li>
        <label>pain debt</label>
        <description>This person can push through injuries by sheer willpower, deferring the full impact of wounds until the fight is over.</description>
        <degree>0</degree>
      </li>
    </degreeDatas>
    <conflictingTraits>
      <li>Wimp</li>
    </conflictingTraits>
    <modExtensions>
      <li Class="RimArt.TraitAbilityExtension">
        <abilities>
          <li>AG_Arrears</li>
        </abilities>
      </li>
    </modExtensions>
  </TraitDef>

</Defs>
