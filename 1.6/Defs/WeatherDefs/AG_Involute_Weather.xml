<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Kamui's dimension, in numbers.

       All four sky slots are identical on purpose: the dimension has no sun to be on one side of,
       so it should not brighten and dim over a day. What the sky colours do here is tint, not
       light - every cell is under thick roof and takes no sky glow at all, so the brightness comes
       entirely from the unseen lights the GenStep spreads. The tint is a near-neutral cold grey,
       so the block field keeps the colours measured from the references (make_kamui_textures.py). -->
  <WeatherDef>
    <defName>AG_InvoluteVoid</defName>
    <label>involute</label>
    <description>There is no weather here. There is no here.</description>
    <repeatable>true</repeatable>
    <favorability>Neutral</favorability>
    <perceivePriority>0</perceivePriority>
    <windSpeedFactor>0</windSpeedFactor>
    <windSpeedOffset>0</windSpeedOffset>
    <rainRate>0</rainRate>
    <snowRate>0</snowRate>
    <durationRange>20000~40000</durationRange>
    <skyColorsDay>
      <sky>(0.45, 0.47, 0.50)</sky>
      <shadow>(0.85, 0.86, 0.88)</shadow>
      <overlay>(0.60, 0.62, 0.65)</overlay>
      <saturation>1.0</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.45, 0.47, 0.50)</sky>
      <shadow>(0.85, 0.86, 0.88)</shadow>
      <overlay>(0.60, 0.62, 0.65)</overlay>
      <saturation>1.0</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.45, 0.47, 0.50)</sky>
      <shadow>(0.85, 0.86, 0.88)</shadow>
      <overlay>(0.60, 0.62, 0.65)</overlay>
      <saturation>1.0</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.45, 0.47, 0.50)</sky>
      <shadow>(0.85, 0.86, 0.88)</shadow>
      <overlay>(0.60, 0.62, 0.65)</overlay>
      <saturation>1.0</saturation>
    </skyColorsNightMid>
  </WeatherDef>

</Defs>
