<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The whole otherworld, in numbers, with no art behind it.

       All four sky slots are identical on purpose: the volume has no sun to be on one side of,
       so it should not brighten and dim over a day. What the sky colours do here is tint, not
       light - every cell in the volume is under thick roof and takes no sky glow at all, so the
       actual brightness comes entirely from the bioluminescence the GenStep scattered.

       Saturation above 1 is what keeps this from being grey sludge. The trick is to lower the
       sky and push the colour up, not to dim everything and hope. -->
  <WeatherDef>
    <defName>AG_InvoluteVoid</defName>
    <label>involute</label>
    <description>There is no weather here. There is no here.</description>
    <repeatable>true</repeatable>
    <favorability>Neutral</favorability>
    <perceivePriority>0</perceivePriority>
    <windSpeedFactor>0</windSpeedFactor>
    <windSpeedOffset>0</windSpeedOffset>
    <rainRate>0</rainRate>
    <snowRate>0</snowRate>
    <durationRange>20000~40000</durationRange>
    <skyColorsDay>
      <sky>(0.32, 0.22, 0.48)</sky>
      <shadow>(0.85, 0.85, 0.90)</shadow>
      <overlay>(0.55, 0.45, 0.70)</overlay>
      <saturation>1.30</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.32, 0.22, 0.48)</sky>
      <shadow>(0.85, 0.85, 0.90)</shadow>
      <overlay>(0.55, 0.45, 0.70)</overlay>
      <saturation>1.30</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.32, 0.22, 0.48)</sky>
      <shadow>(0.85, 0.85, 0.90)</shadow>
      <overlay>(0.55, 0.45, 0.70)</overlay>
      <saturation>1.30</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.32, 0.22, 0.48)</sky>
      <shadow>(0.85, 0.85, 0.90)</shadow>
      <overlay>(0.55, 0.45, 0.70)</overlay>
      <saturation>1.30</saturation>
    </skyColorsNightMid>
  </WeatherDef>

</Defs>
