<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <MapGeneratorDef>
    <defName>AG_InvoluteVolume</defName>
    <label>involute volume</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <!-- The game paints a grey frame (MapEdgeClipDrawer) beyond every map edge. Off here: the
         dimension's blocks run on past the edge and fade out, and MapComponent_KamuiDimension draws a
         black backstop under them for the far corners, as the Infinity Castle does. -->
    <disableMapClippers>true</disableMapClippers>
    <pocketMapProperties>
      <biome>AG_InvoluteVoid</biome>
      <temperature>16</temperature>
    </pocketMapProperties>
    <genSteps>
      <li>AG_InvoluteVolume</li>
    </genSteps>
  </MapGeneratorDef>

  <!-- One step, the whole dimension, from the same generator as the lab's Kamui dimension sketch
       (Source/RimArt/Involute/Kamui/KamuiLayout.cs): a given seed, size, cover and island count is the
       same map in both. The map's size is the gene's volumeSizeX (square). seeds is what a new volume
       picks from (the sketch's seed slider); cover and islands are the sketch's "Walkable share" and
       "Islands at least"; palette is "fight" (the anime seen from above) or "still" (darker). -->
  <GenStepDef>
    <defName>AG_InvoluteVolume</defName>
    <order>500</order>
    <genStep Class="RimArt.GenStep_InvoluteVolume">
      <voidTerrain>AG_KamuiVoid</voidTerrain>
      <topTerrain>AG_KamuiTop</topTerrain>
      <light>AG_KamuiLight</light>
      <lightSpacing>6</lightSpacing>
      <cover>0.55</cover>
      <islands>6</islands>
      <seeds>1~60</seeds>
      <palette>fight</palette>
    </genStep>
  </GenStepDef>

</Defs>
