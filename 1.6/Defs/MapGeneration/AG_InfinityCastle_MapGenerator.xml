<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The Infinity Castle: a 100 x 100 pocket map of rooms hanging in a void. Opened from the RimArts
       debug window (Infinity Castle, "castle map: open"); no ability makes one yet. -->
  <MapGeneratorDef>
    <defName>AG_InfinityCastle</defName>
    <label>infinity castle</label>
    <isUnderground>true</isUnderground>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <!-- The game paints a grey frame (MapEdgeClipDrawer, 0.1 grey, above everything) beyond every map
         edge. Off here: the castle's void plane and its drifting depth rooms run on past the edge, and
         MapComponent_InfinityCastle draws a black backstop under them for the far corners. -->
    <disableMapClippers>true</disableMapClippers>
    <pocketMapProperties>
      <biome>AG_InfinityCastle</biome>
      <temperature>16</temperature>
    </pocketMapProperties>
    <genSteps>
      <li>AG_InfinityCastleRooms</li>
    </genSteps>
    <!-- The castle's numbers (docs/infinity-castle-kit.md); the shapes and timings of the pictures are code. -->
    <modExtensions>
      <li Class="RimArt.InfinityCastleRules">
        <shiftMaxCells>20</shiftMaxCells>
        <shiftCellsPerSecond>8</shiftCellsPerSecond>
        <strumGapSeconds>1.5</strumGapSeconds>
        <voidDropStunSeconds>1</voidDropStunSeconds>
        <crushMinSize>7</crushMinSize>
        <crushBand>2</crushBand>
        <crushDamage>15</crushDamage>
        <crushStunSeconds>1</crushStunSeconds>
        <crushCooldownSeconds>10</crushCooldownSeconds>
      </li>
    </modExtensions>
  </MapGeneratorDef>

  <!-- One step, the whole castle, from the same generator as the lab's Castle sketch
       (Source/RimArt/InfinityCastle/CastleLayout.cs): a given seed and room count is the same castle
       in both. seeds and rooms are what a castle opened without a seed picks from (the sketch's
       sliders). -->
  <GenStepDef>
    <defName>AG_InfinityCastleRooms</defName>
    <order>500</order>
    <genStep Class="RimArt.GenStep_InfinityCastle">
      <voidTerrain>AG_CastleVoid</voidTerrain>
      <floorTerrain>AG_CastleFloor</floorTerrain>
      <wall>AG_CastleWall</wall>
      <lantern>AG_CastleLantern</lantern>
      <seeds>1~60</seeds>
      <rooms>30~45</rooms>
    </genStep>
  </GenStepDef>

</Defs>
