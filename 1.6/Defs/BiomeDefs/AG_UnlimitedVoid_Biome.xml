<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Unlimited Void's pocket map. Nothing lives or grows here; the terrain entry is a fallback the player
       never sees, because the GenStep paints every cell. -->
  <BiomeDef>
    <defName>AG_UnlimitedVoid</defName>
    <label>unlimited void</label>
    <description>Gojo's pocket map for Unlimited Void. Nothing lives or grows here.</description>
    <generatesNaturally>false</generatesNaturally>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <hasVirtualPlants>false</hasVirtualPlants>
    <baseWeatherCommonalities>
      <AG_UnlimitedVoid>1</AG_UnlimitedVoid>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>AG_VoidFloor</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>

</Defs>
