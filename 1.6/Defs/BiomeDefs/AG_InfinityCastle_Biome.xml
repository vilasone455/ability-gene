<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The castle's pocket map. Nothing lives or grows here; the terrain entry is a fallback the
       player never sees, because the GenStep paints every cell. -->
  <BiomeDef>
    <defName>AG_InfinityCastle</defName>
    <label>infinity castle</label>
    <description>Rooms hanging in a dark that goes down forever.</description>
    <generatesNaturally>false</generatesNaturally>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <hasVirtualPlants>false</hasVirtualPlants>
    <baseWeatherCommonalities>
      <AG_InfinityCastle>1</AG_InfinityCastle>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>AG_CastleVoid</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>

</Defs>
