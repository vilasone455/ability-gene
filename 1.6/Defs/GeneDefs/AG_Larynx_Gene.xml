<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_ImperativeLarynx</defName>
    <label>imperative larynx</label>
    <description>A second set of folds above the first, wired to push a word out at a pressure no throat is meant to hold. What lands is not persuasion and not fear: the body does the thing before the person in it has an opinion, then goes straight back to being armed and hostile.\n\nThe folds tear a little every time, heal worse each time, and a carrier who spends a whole raid talking spends the following week unable to.</description>
    <iconPath>UI/Icons/Genes/Gene_AnimalWarcall</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>220</displayOrderInCategory>
    <marketValueFactor>1.8</marketValueFactor>
    <abilities>
      <li>AG_Imperative_Stop</li>
      <li>AG_Imperative_Drop</li>
      <li>AG_Imperative_Kneel</li>
      <li>AG_Imperative_Come</li>
      <li>AG_Imperative_Run</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AG_Imperative_Stop</AbilityDef>
      <AbilityDef>AG_Imperative_Drop</AbilityDef>
      <AbilityDef>AG_Imperative_Kneel</AbilityDef>
      <AbilityDef>AG_Imperative_Come</AbilityDef>
      <AbilityDef>AG_Imperative_Run</AbilityDef>
      <HediffDef>AG_LarynxWear</HediffDef>
    </descriptionHyperlinks>
    <biostatMet>-2</biostatMet>
    <biostatCpx>4</biostatCpx>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>word</symbol></li>
        <li><symbol>call</symbol></li>
        <li><symbol>herald</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>voice</symbol></li>
        <li><symbol>word</symbol></li>
        <li><symbol>call</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
