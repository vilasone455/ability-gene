<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Itachi's organ (docs/hero-echo.md). Echo-only since 2026-09-27: his Echo gives it on
       awakening (awakenGenes) and grants Murder and Carrion while he is manifested, so the gene
       lists no abilities of its own. The charges live here and keep regrowing between manifests;
       Scatter and the toggle ask EchoUtility.GeneActive and do nothing outside hero form. Kept
       out of genepacks and random xenotypes; the def stays loadable for saves that hold it. -->
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_DispersalPlexus</defName>
    <label>dispersal plexus</label>
    <description>Itachi's body, which comes apart into crows. It works only in hero form. Automatic Scatter cancels an incoming hit of 6 or more damage and reforms him a few cells away; Crow Dispersal is deliberate flight to a chosen spot; Carrion sends the flock to strip a corpse and bring the recovery back.\n\nAll three share three charges, one regrowing each game hour whether or not he is manifested, and every Scatter costs blood as well as a charge.</description>
    <geneClass>RimArt.Gene_Dispersal</geneClass>
    <iconPath>RimArt/Dispersal/IconGene</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>250</displayOrderInCategory>
    <marketValueFactor>1.9</marketValueFactor>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <selectionWeight>0</selectionWeight>
    <descriptionHyperlinks>
      <AbilityDef>AG_DispersalMurder</AbilityDef>
      <AbilityDef>AG_DispersalCarrion</AbilityDef>
      <HediffDef>AG_Reassembling</HediffDef>
      <HediffDef>BloodLoss</HediffDef>
    </descriptionHyperlinks>
    <biostatMet>-3</biostatMet>
    <biostatCpx>5</biostatCpx>
    <modExtensions>
      <li Class="RimArt.DispersalGeneExtension">
        <maxCharges>3</maxCharges>
        <rechargeTicks>2500</rechargeTicks>
        <minimumDamage>6</minimumDamage>
        <bloodLossPerScatter>0.04</bloodLossPerScatter>
        <minRange>5</minRange>
        <maxRange>10</maxRange>
      </li>
    </modExtensions>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>crow</symbol></li>
        <li><symbol>scatter</symbol></li>
        <li><symbol>flock</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>wing</symbol></li>
        <li><symbol>feather</symbol></li>
        <li><symbol>flight</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
