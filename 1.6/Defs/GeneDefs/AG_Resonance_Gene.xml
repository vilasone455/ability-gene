<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_ResonantMarrow</defName>
    <label>resonant marrow</label>
    <description>A skeleton that holds a note: every blow this person lands sets the struck part ringing for several seconds, and a second blow in the same place while the note is live is more than that piece of body can carry.\n\nIt is not a harder hit, only timing - and the marrow does not know whose bone it is standing in.</description>
    <iconPath>UI/Icons/Genes/Gene_StrongMeleeDamage</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>180</displayOrderInCategory>
    <marketValueFactor>1.6</marketValueFactor>
    <abilities>
      <li>AG_Resonance</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AG_Resonance</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-2</biostatMet>
    <biostatCpx>3</biostatCpx>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>ring</symbol></li>
        <li><symbol>chime</symbol></li>
        <li><symbol>phase</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>note</symbol></li>
        <li><symbol>ring</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
