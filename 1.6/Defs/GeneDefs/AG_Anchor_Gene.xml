<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_AnchorOrgan</defName>
    <label>anchor organ</label>
    <description>Clap to change places with anyone in sight nearby, or clap twice to make two others change places. Stones thrown onto the ground can be clapped with from anywhere on the map, without line of sight.\n\nThree claps at a time, growing back one every 10 seconds. The clap takes both hands, so this carrier never carries a weapon.</description>
    <geneClass>RimArt.Gene_Anchors</geneClass>
    <iconPath>UI/Icons/Genes/Gene_ElongatedFingers</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>170</displayOrderInCategory>
    <marketValueFactor>2.0</marketValueFactor>
    <abilities>
      <li>AG_AnchorMark</li>
      <li>AG_AnchorClap</li>
      <li>AG_AnchorDoubleClap</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AG_AnchorMark</AbilityDef>
      <AbilityDef>AG_AnchorClap</AbilityDef>
      <AbilityDef>AG_AnchorDoubleClap</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-2</biostatMet>
    <biostatCpx>4</biostatCpx>
    <modExtensions>
      <li Class="RimArt.AnchorGeneExtension">
        <maxAnchors>3</maxAnchors>
        <markDurationTicks>60000</markDurationTicks>
        <banWeapons>true</banWeapons>
        <stoneDef>AG_ClapStone</stoneDef>
        <directSwapRange>15</directSwapRange>
        <longSwapRange>25</longSwapRange>
        <clapCharges>3</clapCharges>
        <chargeRechargeTicks>600</chargeRechargeTicks>
        <swapStunTicks>30</swapStunTicks>
      </li>
    </modExtensions>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>anchor</symbol></li>
        <li><symbol>clap</symbol></li>
        <li><symbol>fold</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>mark</symbol></li>
        <li><symbol>step</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
