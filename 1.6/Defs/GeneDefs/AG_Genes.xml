<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_CorrosiveGlands</defName>
    <label>corrosive glands</label>
    <description>Glands behind the carrier's jaw hold a contact acid strong enough to ruin a grip in under a second. Spat accurately, it makes a person drop whatever they are carrying without doing them any real harm.\n\nThe obvious use is taking a dangerous weapon off a raider you would rather recruit than bury.</description>
    <iconPath>UI/Icons/Genes/Gene_AcidSpray</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <abilities>
      <li>AG_DisarmSpit</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AG_DisarmSpit</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-2</biostatMet>
    <biostatCpx>1</biostatCpx>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>acid</symbol></li>
        <li><symbol>etch</symbol></li>
        <li><symbol>corro</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>spit</symbol></li>
        <li><symbol>etcher</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_HypermetabolicGlands</defName>
    <label>hypermetabolic glands</label>
    <description>The carrier's metabolism has no upper governor. On command they burn food reserves straight into tissue repair, closing wounds at a rate that would take an ordinary body days.\n\nThe body does not care whether it can afford this, and on serious injuries it will run its owner into starvation.</description>
    <iconPath>UI/Icons/Genes/Gene_RobustDigestion</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>110</displayOrderInCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <abilities>
      <li>AG_MetabolicOverdrive</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AG_MetabolicOverdrive</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-3</biostatMet>
    <biostatCpx>2</biostatCpx>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>burn</symbol></li>
        <li><symbol>ember</symbol></li>
        <li><symbol>furn</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>burner</symbol></li>
        <li><symbol>forge</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
