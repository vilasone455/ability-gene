<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_HalvingMembrane</defName>
    <label>halving membrane</label>
    <description>A membrane the carrier holds open across their own surface. It does not stop what is coming, it divides the distance - each thing crosses half the remaining gap, then half of what is left, and never takes the last step.\n\nNothing is blocked or absorbed, only still on its way, and the membrane cannot tell that air is approaching too.</description>
    <iconPath>UI/Icons/Genes/Gene_Deathless</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>170</displayOrderInCategory>
    <marketValueFactor>2.5</marketValueFactor>
    <abilities>
      <li>AG_Recursion</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AG_Recursion</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-4</biostatMet>
    <biostatCpx>6</biostatCpx>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>half</symbol></li>
        <li><symbol>near</symbol></li>
        <li><symbol>zeno</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>brane</symbol></li>
        <li><symbol>half</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
