<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_InvoluteOrgan</defName>
    <label>fold organ</label>
    <description>One part of the carrier's body - rolled when the gene lands, named on their health tab - is not entirely there, and they are permanently worse at whatever that part did. Connected, anything striking that part arrives inside a room that is not anywhere instead of landing on them.\n\nThey can step through it, put people through it, store things in it, and end the whole volume with everything still inside.</description>
    <geneClass>RimArt.Gene_Involute</geneClass>
    <iconPath>UI/Icons/Genes/Gene_ExtremePsychicAbility</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <marketValueFactor>3.0</marketValueFactor>
    <abilities>
      <li>AG_InvoluteVent</li>
      <li>AG_InvoluteFold</li>
      <li>AG_InvoluteSwallow</li>
      <li>AG_InvolutePost</li>
      <li>AG_InvoluteCollapse</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>AG_InvoluteVent</AbilityDef>
      <AbilityDef>AG_InvoluteFold</AbilityDef>
      <AbilityDef>AG_InvoluteSwallow</AbilityDef>
      <AbilityDef>AG_InvolutePost</AbilityDef>
      <AbilityDef>AG_InvoluteCollapse</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-4</biostatMet>
    <biostatCpx>7</biostatCpx>
    <biostatArc>1</biostatArc>
    <modExtensions>
      <li Class="RimArt.InvoluteGeneExtension">
        <volumeSizeX>48</volumeSizeX>
        <volumeSizeZ>48</volumeSizeZ>
        <volumeGenerator>AG_InvoluteVolume</volumeGenerator>

        <!-- The roll can reach the torso and the head, not just limbs. Rare - one candidate in
             about fifteen - and a trade rather than a prize: a torso hole stops roughly 40% of
             incoming fire, and puts the hole's efficiency penalty on the part everything else
             hangs off. That carrier is hard to kill and barely able to work. -->
        <allowAnyPart>true</allowAnyPart>
        <minHoleCoverage>0.02</minHoleCoverage>
        <maxHoleCoverage>1.0</maxHoleCoverage>
        <holeEfficiencyOffset>-0.5</holeEfficiencyOffset>
        <maxSwallowBodySize>1.2</maxSwallowBodySize>
      </li>
    </modExtensions>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>fold</symbol></li>
        <li><symbol>hollow</symbol></li>
        <li><symbol>void</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>hole</symbol></li>
        <li><symbol>gate</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
