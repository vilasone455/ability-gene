<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Obito's Echo-only gene (docs/hero-echo.md "Obito"): the Obito Echo gives it on awakening and it stays
       for life. It holds the Kamui dimension (built on awakening) and what he stored there; his four abilities
       come from the Echo (AG_Obito_Abilities.xml) and work only in hero form. Not in genepacks or generated
       xenotypes. -->
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>AG_InvoluteOrgan</defName>
    <label>Kamui</label>
    <description>Obito's right eye and the dimension behind it: a field of stone blocks in a void that only he can reach. It works only in hero form.\n\nWhile phased, every hit on him goes through him into the dimension. He can step into it and out anywhere on the map he left, absorb a person or an item stack by touch, and put what he stored back out. What he stored stays inside between manifests; on his death or the loss of this gene everything inside comes out.</description>
    <geneClass>RimArt.Gene_Involute</geneClass>
    <iconPath>UI/Icons/Genes/Gene_ExtremePsychicAbility</iconPath>
    <displayCategory>Ability</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <marketValueFactor>3.0</marketValueFactor>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <selectionWeight>0</selectionWeight>
    <descriptionHyperlinks>
      <AbilityDef>AG_KamuiPhase</AbilityDef>
      <AbilityDef>AG_KamuiWarp</AbilityDef>
      <AbilityDef>AG_KamuiStore</AbilityDef>
      <AbilityDef>AG_WoodRelease</AbilityDef>
    </descriptionHyperlinks>
    <biostatMet>-4</biostatMet>
    <biostatCpx>7</biostatCpx>
    <biostatArc>1</biostatArc>
    <modExtensions>
      <li Class="RimArt.InvoluteGeneExtension">
        <volumeSizeX>48</volumeSizeX>
        <volumeSizeZ>48</volumeSizeZ>
        <volumeGenerator>AG_InvoluteVolume</volumeGenerator>
      </li>
    </modExtensions>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>fold</symbol></li>
        <li><symbol>hollow</symbol></li>
        <li><symbol>void</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>hole</symbol></li>
        <li><symbol>gate</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>
