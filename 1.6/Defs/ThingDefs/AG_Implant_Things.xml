<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The devices the install surgeries consume.

       These did not exist. The recipes inherited SurgeryInstallImplantBase and never
       overrode its ingredients, which is two medicine and nothing else, so an archotech
       phase barrier cost a doctor and a pair of herbal poultices and could be fitted to
       every colonist on day one. Every vanilla implant recipe names the item it consumes;
       these now do too.

       Each ThingDef deliberately shares its defName with the HediffDef it installs. That is
       the vanilla convention - Joywire is both an item and a hediff - and the two live in
       separate databases, so there is no collision.

       No new art: the Core health-item sprite is tinted per tier by the parent, which is
       how every vanilla prosthetic, bionic and archotech part is drawn. -->

  <!-- Echo-only since the Accelerator port (docs/hero-echo.md): the booster grants no ability, cannot be
       crafted, is no longer a reward and is not given to generated pawns. The def stays loadable for saves
       and pawns that hold one. -->
  <ThingDef ParentName="BodyPartProstheticBase">
    <defName>AG_ReflexBooster</defName>
    <label>reflex booster</label>
    <description>An uncraftable spinal implant. Its vector powers now belong to Accelerator's Echo, so it grants no ability. It can be recovered surgically and transferred.</description>
    <descriptionHyperlinks><RecipeDef>AG_InstallReflexBooster</RecipeDef></descriptionHyperlinks>
    <!-- BodyPartProstheticBase has a recipeMaker of its own; a recipe with no cost is a config error. -->
    <recipeMaker IsNull="True" />
    <statBases>
      <MarketValue>600</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
  </ThingDef>

  <!-- Spacer. Fabrication bench, behind Bionics, same as a bionic eye. -->
  <ThingDef ParentName="BodyPartBionicBase">
    <defName>AG_NeuralAccelerator</defName>
    <label>neural accelerator</label>
    <description>A brain implant that changes its user's internal rate of time. Acceleration leaves strain that sheds slowly and does not care whether the fight is over.</description>
    <descriptionHyperlinks><RecipeDef>AG_InstallNeuralAccelerator</RecipeDef></descriptionHyperlinks>
    <costList>
      <Plasteel>20</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <thingSetMakerTags>
      <li>RewardStandardMidFreq</li>
    </thingSetMakerTags>
  </ThingDef>

  <!-- Echo-only since the Gojo port (docs/hero-echo.md): the barrier grants no ability, is no longer a reward and
       was never craftable (archotech). The def stays loadable for saves and pawns that hold one. -->
  <ThingDef ParentName="BodyPartArchotechBase">
    <defName>AG_PhaseBarrier</defName>
    <label>phase barrier</label>
    <description>An archotech brain implant. Its phase guard now belongs to Gojo's Echo, so it grants no ability. It can be recovered surgically and transferred.</description>
    <descriptionHyperlinks><RecipeDef>AG_InstallPhaseBarrier</RecipeDef></descriptionHyperlinks>
    <statBases>
      <MarketValue>3200</MarketValue>
      <Mass>0.3</Mass>
    </statBases>
  </ThingDef>

</Defs>
