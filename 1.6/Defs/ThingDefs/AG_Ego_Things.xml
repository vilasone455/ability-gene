<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- E.G.O. weapons (docs/ego-weapons.md). Every number is a placeholder until the balance pass in game.
       The Corrosion numbers are fields of the weapon's CompProperties_EgoWeapon subclass; the rules are in
       Source/RimArt/Ego/Kit. None of them can be made, bought or found yet: how a colony gets one is open in the doc.
       No weaponTags, so no pawn kind spawns carrying one. -->

  <!-- Magic Bullet's round. Never spawned: Verb_EgoMagicBullet lays a line instead of firing a projectile. The
       verb needs a defaultProjectile to be available, and this one carries the damage of shots one to six, its
       armour penetration and the info card's numbers. The seventh's damage is seventhDamage on the weapon. -->
  <ThingDef ParentName="BaseBullet">
    <defName>AG_EgoMagicBullet_Round</defName>
    <label>magic bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>18</damageAmountBase>
      <armorPenetrationBase>0.3</armorPenetrationBase>
      <stoppingPower>1</stoppingPower>
      <speed>120</speed>
    </projectile>
  </ThingDef>

  <!-- Magic Bullet (Der Freischütz, WAW). One shot per use: a line from the shooter's cell through the target to
       the verb's range (40), through walls and cover, hitting every pawn whose cell it passes, allies and the downed
       included; it never misses, so the accuracy stats are 1. Shots count on the gun (CompEgoMagicBullet.count,
       saved with the gun); the seventh goes to the shooter's beloved instead (EgoMagicBullet.Beloved) for
       seventhDamage, then the gun does not fire for seventhCooldown s. requireLineOfSight is off so a target behind
       a wall can be ordered. The comps are listed with Inherit="False" because CompProperties_EgoMagicBullet is the
       weapon's CompEquippable (the count and Overclock are equipped gizmos); Forbiddable and Styleable are
       BaseWeapon's own. No quality and no art: E.G.O. gear is not made. -->
  <ThingDef ParentName="BaseGun">
    <defName>AG_EgoMagicBullet</defName>
    <label>Magic Bullet</label>
    <description>A long black rifle with a gold band round the chamber: E.G.O. gear from Der Freischütz.\n\nEach shot is a straight line 40 tiles long. It goes through walls and cover, never misses, and hits every pawn on it, allies and the downed included, for 18 damage.\n\nThe gun counts its shots, and the count stays with the gun when it is dropped. The seventh shot cannot be aimed: it goes to the pawn on the map the shooter has the highest opinion of (if there is a tie or nobody, a bonded animal; if none, the shooter), hitting everyone between for 30 damage. After it the gun does not fire for 20 seconds. On the sixth shot the counter names the pawn the seventh will hit.\n\nCorrosion: every shot may let the gun take its wielder. The chance is 25% below the wielder's minor break threshold, 75% below the major one and certain below the extreme one, one step worse under Shooting 6, and none above the minor threshold. A corroded wielder ignores orders for 30 seconds while the gun fires a line at the nearest pawn of any faction every 3 seconds, then is exhausted for 2 hours. These shots count toward the seventh.\n\nOverclock: the wielder fires 6 lines, one a second, at the nearest hostile within 40 tiles. Only hostiles are hit and the count does not move. Costs 15 mood for 1 day.</description>
    <graphicData>
      <texPath>RimArt/Ego/MagicBullet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.55</drawSize>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <soundInteract>Interact_Rifle</soundInteract>
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
    <relicChance>0</relicChance>
    <weaponTags Inherit="False" />
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>4.5</Mass>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>RimArt.Verb_EgoMagicBullet</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>AG_EgoMagicBullet_Round</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>40</range>
        <burstShotCount>1</burstShotCount>
        <requireLineOfSight>false</requireLineOfSight>
        <soundCast>Shot_SniperRifle</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
    <comps Inherit="False">
      <li Class="RimArt.CompProperties_EgoMagicBullet">
        <actionClass>RimArt.EgoMagicBulletCorrosion</actionClass>
        <corrosionMinor>0.25</corrosionMinor>
        <corrosionMajor>0.75</corrosionMajor>
        <corrosionExtreme>1</corrosionExtreme>
        <requirementSkill>Shooting</requirementSkill>
        <requirementLevel>6</requirementLevel>
        <corrodedDuration>30</corrodedDuration>
        <corrodedInterval>3</corrodedInterval>
        <exhaustionHours>2</exhaustionHours>
        <overclockCount>6</overclockCount>
        <overclockInterval>1</overclockInterval>
        <overclockRange>40</overclockRange>
        <overclockMood>-15</overclockMood>
        <overclockMoodDays>1</overclockMoodDays>
        <seventhDamage>30</seventhDamage>
        <seventhCooldown>20</seventhCooldown>
        <actionAim>0.45</actionAim>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
    </comps>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <!-- Solemn Lament's black round. Never spawned: Verb_EgoSolemnLament hits the target itself. It carries the black
       shot's damage, armour penetration and the info card's numbers; the white shot does no harm. -->
  <ThingDef ParentName="BaseBullet">
    <defName>AG_EgoSolemnLament_Round</defName>
    <label>departed round</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>9</damageAmountBase>
      <armorPenetrationBase>0.14</armorPenetrationBase>
      <stoppingPower>0.5</stoppingPower>
      <speed>60</speed>
    </projectile>
  </ThingDef>

  <!-- Solemn Lament (Funeral of the Dead Butterflies, WAW): one item, a white and a black pistol drawn together.
       A burst of 4 shots 0.25 s apart (ticksBetweenBurstShots 15), the guns taking turns, white first and on
       across bursts; every shot hits its target (accuracy 1). White: 2 Butterfly stacks, no harm. Black: 9 damage
       and 1 stack. The guns never put on more than Butterfly's cap (10, on AG_EgoButterfly), so they down a pawn at
       the cap and never kill it with stacks. 20 shots, then 3 s to reload. Corroded, the coffin: the wielder walks
       to the nearest pawn and every pawn within 3 cells takes 1 stack a second, past the cap, and dies at 20. The
       comps are listed with Inherit="False" because CompProperties_EgoSolemnLament is the weapon's CompEquippable
       (the pool and Overclock are equipped gizmos). No quality and no art: E.G.O. gear is not made. -->
  <ThingDef ParentName="BaseGun">
    <defName>AG_EgoSolemnLament</defName>
    <label>Solemn Lament</label>
    <description>A pair of pistols, one white and one black: E.G.O. gear from the Funeral of the Dead Butterflies. The wielder holds both and they take turns, white first.\n\nEach pull of the trigger fires 4 shots, one every 0.25 seconds, at a target up to 10 tiles away. Every shot hits. A white shot does no harm and puts 2 Butterfly stacks on the target. A black shot does 9 damage and puts on 1 stack. The pair holds 20 shots and reloads for 3 seconds when empty.\n\nButterfly: each stack takes 7.5% consciousness, so an unhurt pawn goes down at 10 stacks, the cap. The guns never put on more than 10. One stack fades every 10 seconds.\n\nCorrosion: every shot may let the guns take their wielder. The chance is 25% below the wielder's minor break threshold, 75% below the major one and certain below the extreme one, one step worse under Shooting 4, and none above the minor threshold. A coffin rises where the wielder stands and a cloud of butterflies circles the wielder for 30 seconds. The wielder ignores orders and walks to the nearest person or animal, of any faction, downed or not, and stays beside them. Every second each pawn within 3 tiles of the wielder takes 1 stack, past the cap: a pawn left down in the cloud dies at 20 stacks. Then the wielder is exhausted for 2 hours.\n\nOverclock: the coffin for 5 seconds where the wielder stands. Each second every standing hostile within 3 tiles takes 1 stack, never past the cap. Costs 15 mood for 1 day.</description>
    <graphicData>
      <texPath>RimArt/Ego/SolemnLament</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <soundInteract>Interact_Autopistol</soundInteract>
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
    <relicChance>0</relicChance>
    <weaponTags Inherit="False" />
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>2.2</Mass>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>RimArt.Verb_EgoSolemnLament</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>AG_EgoSolemnLament_Round</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>10</range>
        <burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
      </li>
    </verbs>
    <comps Inherit="False">
      <li Class="RimArt.CompProperties_EgoSolemnLament">
        <actionClass>RimArt.EgoSolemnLamentCorrosion</actionClass>
        <corrosionMinor>0.25</corrosionMinor>
        <corrosionMajor>0.75</corrosionMajor>
        <corrosionExtreme>1</corrosionExtreme>
        <requirementSkill>Shooting</requirementSkill>
        <requirementLevel>4</requirementLevel>
        <corrodedDuration>30</corrodedDuration>
        <corrodedInterval>1</corrodedInterval>
        <exhaustionHours>2</exhaustionHours>
        <overclockCount>5</overclockCount>
        <overclockInterval>1</overclockInterval>
        <overclockRange>3</overclockRange>
        <overclockMood>-15</overclockMood>
        <overclockMoodDays>1</overclockMoodDays>
        <whiteStacks>2</whiteStacks>
        <blackStacks>1</blackStacks>
        <ammo>20</ammo>
        <reloadSeconds>3</reloadSeconds>
        <coffinRadius>3</coffinRadius>
        <cloudStacks>1</cloudStacks>
        <funeralStacks>20</funeralStacks>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
    </comps>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>
