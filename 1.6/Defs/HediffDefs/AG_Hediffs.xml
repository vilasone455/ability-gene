<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Duration comes from each ability's Ability_Duration stat, so
       HediffCompProperties_Disappears needs no explicit tick count.

       The shared comps live here and ONLY here: a child's <comps> list is merged with its
       parent's, not substituted for it, so repeating one in a child gives the hediff two
       copies of that comp and a config error at load. -->
  <HediffDef Name="AG_AbilityHediffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <makesSickThought>false</makesSickThought>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <HediffDef ParentName="AG_AbilityHediffBase">
    <defName>AG_MetabolicOverdrive</defName>
    <label>metabolic overdrive</label>
    <description>This person's metabolism is running far past its normal ceiling, burning through food reserves to close wounds at a visible rate. It stops on its own once there is nothing left to heal, or nothing left to burn.</description>
    <defaultLabelColor>(1, 0.7, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="AbilityGenes.HediffCompProperties_MetabolicOverdrive">
        <intervalTicks>60</intervalTicks>
        <nutritionPerInterval>0.05</nutritionPerInterval>
        <healPerInterval>1.5</healPerInterval>
      </li>
    </comps>
    <stages>
      <li>
        <!-- Running this hot is exhausting, and it shows. -->
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="AG_AbilityHediffBase">
    <defName>AG_Provoking</defName>
    <label>provoking</label>
    <description>This person is flooding the air with a blend of alarm pheromones tuned to read as an immediate threat. Every hostile close enough to smell it wants them dead before anything else.\n\nTheir skin has tightened in anticipation, turning aside some of what is about to arrive.</description>
    <defaultLabelColor>(1, 0.4, 0.35)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="AbilityGenes.HediffCompProperties_Provoke">
        <radius>12.9</radius>
        <intervalTicks>60</intervalTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.85</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
