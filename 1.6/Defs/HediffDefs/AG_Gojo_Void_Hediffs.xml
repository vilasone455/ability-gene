<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Void overload, from Unlimited Void (AG_GojoUnlimitedVoid). Severity is the overload, 0 to 1. Inside the
       domain it builds (overloadPerSecond on the ability) and does nothing; when the pawn comes out, the stage
       (made in C#, one per 1 % step) caps Consciousness at 1 minus the overload, never below
       consciousnessFloor, and the overload falls recoveryPerSecond until it is gone. The game downs a pawn under
       30 % consciousness, so over 70 % overload it is down until the overload falls back to 70 %. A pawn that
       came out over scarAbove gets scarHediff when the overload has gone.
       Examples with these numbers: 3 s frozen = 70 % for 60 s; 10 s = 10 %, downed 60 s, 140 s recovering,
       then scarred. -->
  <HediffDef>
    <defName>AG_VoidOverload</defName>
    <label>void overload</label>
    <description>Frozen inside Unlimited Void. Once out, consciousness is capped at 100% minus the overload, never below 10%, and the overload falls 0.5% per second. Over 70% the pawn is downed until it falls back to 70%.</description>
    <hediffClass>RimArt.Hediff_VoidOverload</hediffClass>
    <defaultLabelColor>(0.6, 0.5, 0.95)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <makesSickThought>false</makesSickThought>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.001</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="RimArt.HediffCompProperties_VoidOverload">
        <recoveryPerSecond>0.005</recoveryPerSecond>
        <consciousnessFloor>0.1</consciousnessFloor>
        <scarAbove>0.7</scarAbove>
        <scarHediff>AG_VoidScarred</scarHediff>
      </li>
    </comps>
  </HediffDef>

  <!-- Void-scarred: for a pawn that came out of Unlimited Void over 70 % overload (so went down), given when
       the overload has gone. 2 days. -->
  <HediffDef>
    <defName>AG_VoidScarred</defName>
    <label>void-scarred</label>
    <description>Came out of Unlimited Void with over 70% overload. Consciousness -15% and sight -20% for 2 days.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.5, 0.95)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <makesSickThought>false</makesSickThought>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
