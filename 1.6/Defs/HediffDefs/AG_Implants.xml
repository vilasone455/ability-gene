<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Reflex booster implant. Echo-only since the Accelerator port: it grants nothing; vector
       manipulation, reflex surge and vector shove come from Accelerator's Echo. The def stays loadable. -->
  <HediffDef>
    <defName>AG_ReflexBooster</defName>
    <hediffClass>Hediff_Implant</hediffClass>
    <label>reflex booster</label>
    <labelNoun>a reflex booster</labelNoun>
    <description>A spinal implant. Its vector powers come from Accelerator's Echo since the hero port; the implant no longer grants them.</description>
    <defaultLabelColor>(0.6, 0.8, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <spawnThingOnRemoved>AG_ReflexBooster</spawnThingOnRemoved>
  </HediffDef>

  <!-- Phase barrier implant. Echo-only since the Gojo port: it grants nothing; Phase Guard (Infinity) comes from
       Gojo's Echo. The def stays loadable. -->
  <HediffDef>
    <defName>AG_PhaseBarrier</defName>
    <hediffClass>Hediff_Implant</hediffClass>
    <label>phase barrier</label>
    <labelNoun>a phase barrier</labelNoun>
    <description>An archotech brain implant. Its phase guard comes from Gojo's Echo since the hero port; the implant no longer grants it.</description>
    <defaultLabelColor>(0.5, 1.0, 0.6)</defaultLabelColor>
    <isBad>false</isBad>
    <spawnThingOnRemoved>AG_PhaseBarrier</spawnThingOnRemoved>
  </HediffDef>

  <!-- Neural accelerator implant — grants the three time-alter abilities. -->
  <HediffDef>
    <defName>AG_NeuralAccelerator</defName>
    <hediffClass>Hediff_Implant</hediffClass>
    <label>neural accelerator</label>
    <labelNoun>a neural accelerator</labelNoun>
    <description>A brain implant that changes its user's internal rate of time. It can accelerate them to twice or four times normal speed, or slow them to one third.</description>
    <defaultLabelColor>(0.6, 0.8, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <abilities>
      <li>AG_TimeAlterDouble</li>
      <li>AG_TimeAlterSquare</li>
      <li>AG_TimeAlterStagnate</li>
    </abilities>
  </HediffDef>

</Defs>
