<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- After a Black Flash (CompAbilityEffect_BlackFlash). A second Black Flash restarts it. -->
  <HediffDef>
    <defName>AG_BlackFlashZone</defName>
    <label>in the zone</label>
    <description>Just landed a Black Flash. Every punch feels like it will land.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.2, 0.25)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>0.15</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

</Defs>
