<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Reinforcement's buff (AG_Trace_Reinforcement). The ability sets how long it lasts (durationSecondsOverride
       replaces disappearsAfterTicks). HediffComp_TraceReinforced draws the picture: the weapon's glow, footprints
       and heel streaks while moving, the slash of each melee hit, the circuit running back when it ends.
       Every number is a placeholder. -->
  <HediffDef>
    <defName>AG_TraceReinforced</defName>
    <label>reinforced</label>
    <description>Moving 30% faster and dealing 40% more melee damage, from Reinforcement.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.35, 1, 0.82)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="RimArt.HediffCompProperties_TraceReinforced" />
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.3</MoveSpeed>
          <MeleeDamageFactor>1.4</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
