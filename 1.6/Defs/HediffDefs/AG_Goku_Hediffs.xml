<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Solar Flare's blindness. The length is the ability's blindSeconds (AG_GokuSolarFlare), which
       sets the Disappears comp when the flash lands; 1200 ticks here is only its default. -->
  <HediffDef>
    <defName>AG_GokuFlashBlind</defName>
    <label>flash-blinded</label>
    <description>A blinding flash. The eyes see almost nothing until the afterimage fades.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.95, 0.6)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1200</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.8</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
