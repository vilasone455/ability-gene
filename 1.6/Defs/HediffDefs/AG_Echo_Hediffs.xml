<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Hero form. Each Echo has its own child with its stat offsets in a stage; the work block
       lives on the comp so it is written once here. Hero form fights and moves only. -->
  <HediffDef Name="AG_EchoManifestBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(0.55, 0.8, 1)</defaultLabelColor>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="RimArt.HediffCompProperties_EchoManifest">
        <disabledWorkTags>ManualDumb, ManualSkilled, Caring, Social, Intellectual, Animals, Artistic, Crafting, Cooking, Firefighting, Cleaning, Hauling, PlantWork, Mining, Hunting, Constructing</disabledWorkTags>
      </li>
    </comps>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Accelerator</defName>
    <label>hero form: Accelerator</label>
    <description>This Host has manifested Accelerator. The Echo's abilities are available and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.6</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- The Akatsuki cloak, shared: every Echo who wears it takes this as its parent, and its own
       hero form adds only its label, description and stages. A picture only, like Vergil's coat: the
       Host's apparel stays worn and its armour still counts, but its clothes, armour and headgear are
       not drawn (belts and packs still are). Two nodes:
       - the cloak on the body (layer 29, north 29 too: the collar covers the nape instead), one
         texture per body type;
       - the high collar on the head, over the hair (62) and beard (60), under the head wounds (65),
         so it covers the chin and follows the head when the pawn crawls or swims. One texture set,
         fitted to the average vanilla heads and narrowed on narrow ones (narrowHeadScale).
       Textures: make_costume_textures.py. -->
  <HediffDef Name="AG_EchoManifest_Akatsuki" ParentName="AG_EchoManifestBase" Abstract="True">
    <renderNodeProperties>
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Akatsuki cloak</debugLabel>
        <hideBodyApparel>true</hideBodyApparel>
        <hideHeadgear>true</hideHeadgear>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>ApparelBody</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/AkatsukiCloak_Thin</texPath>
        <bodyTypeGraphicPaths>
          <Thin>RimArt/Echo/Costume/AkatsukiCloak_Thin</Thin>
          <Male>RimArt/Echo/Costume/AkatsukiCloak_Male</Male>
          <Female>RimArt/Echo/Costume/AkatsukiCloak_Female</Female>
          <Fat>RimArt/Echo/Costume/AkatsukiCloak_Fat</Fat>
          <Hulk>RimArt/Echo/Costume/AkatsukiCloak_Hulk</Hulk>
        </bodyTypeGraphicPaths>
        <baseLayer>29</baseLayer>
      </li>
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Akatsuki collar</debugLabel>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>Head</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/AkatsukiCollar</texPath>
        <narrowHeadScale>(0.84, 0.7)</narrowHeadScale>
        <baseLayer>64</baseLayer>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifest_Akatsuki">
    <defName>AG_EchoManifest_Pain</defName>
    <label>hero form: Pain</label>
    <description>This Host has manifested Pain. The Echo's abilities are available and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <stages>
      <li>
        <painFactor>0.5</painFactor>
      </li>
    </stages>
    <renderNodeProperties>
      <!-- His piercings, added to the parent's cloak and collar: on the head over the beard and Facial
           Animation's face parts (60 and below), under the hair (62), so hair that hangs over the ears
           hides the ear studs. The same on both sides, so west is east mirrored. -->
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Pain piercings</debugLabel>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>Head</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/PainPiercings</texPath>
        <narrowHeadScale>(0.84, 0.7)</narrowHeadScale>
        <baseLayer>61</baseLayer>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Inumaki</defName>
    <label>hero form: Inumaki</label>
    <description>This Host has manifested Inumaki. The Echo's abilities are available and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <comps>
      <!-- Merged with the base's comps: adds the whisper / speak / shout toggle. -->
      <li Class="RimArt.HediffCompProperties_WordVolume" />
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.3</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Vergil</defName>
    <label>hero form: Vergil</label>
    <description>This Host has manifested Vergil. The colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.5</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <renderNodeProperties>
      <!-- Vergil's coat, a picture only: the Host's apparel stays worn and its armour still counts, but
           its clothes, armour and headgear are not drawn while the coat is on (belts and packs still are).
           Layer 29: over the belts and packs (20 + one per worn piece) and under the post-apparel wounds
           (30); facing north it goes over the head as vanilla shells do (88), so the collar covers the
           nape. Adult humans are Thin in hero form; the other body types fit races that keep their own.
           Textures: make_costume_textures.py. -->
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Vergil coat</debugLabel>
        <hideBodyApparel>true</hideBodyApparel>
        <hideHeadgear>true</hideHeadgear>
        <!-- Judgement Cut End kneels facing south in this (VergilCoatKneel_Thin); other body types
             have no kneel picture and are squashed instead. -->
        <kneelTexPath>RimArt/Echo/Costume/VergilCoatKneel</kneelTexPath>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>ApparelBody</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/VergilCoat_Thin</texPath>
        <bodyTypeGraphicPaths>
          <Thin>RimArt/Echo/Costume/VergilCoat_Thin</Thin>
          <Male>RimArt/Echo/Costume/VergilCoat_Male</Male>
          <Female>RimArt/Echo/Costume/VergilCoat_Female</Female>
          <Fat>RimArt/Echo/Costume/VergilCoat_Fat</Fat>
          <Hulk>RimArt/Echo/Costume/VergilCoat_Hulk</Hulk>
        </bodyTypeGraphicPaths>
        <baseLayer>29</baseLayer>
        <drawData>
          <dataNorth>
            <layer>89</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Shikamaru</defName>
    <label>hero form: Shikamaru</label>
    <description>This Host has manifested Shikamaru. The Echo's abilities are available and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.2</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Shirou</defName>
    <label>hero form: Shirou</label>
    <description>This Host has manifested Shirou. The Echo's abilities are available and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.4</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifest_Akatsuki">
    <defName>AG_EchoManifest_Itachi</defName>
    <label>hero form: Itachi</label>
    <description>This Host has manifested Itachi. The Echo's abilities are available, the dispersal plexus is awake and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
  </HediffDef>

  <!-- Obito's hero form. No Echo points here yet: his EchoDef (docs/hero-echo.md, "Obito") comes with
       his kit's port and names this as its manifestHediff. The Akatsuki cloak comes from the parent;
       the spiral mask is added on the head over the hair (62) and under the collar (64), with its own
       west picture because the eye hole is only on his right side. coversFace keeps Facial Animation's
       eyebrows (layer 100 by default) off the mask. -->
  <HediffDef ParentName="AG_EchoManifest_Akatsuki">
    <defName>AG_EchoManifest_Obito</defName>
    <label>hero form: Obito</label>
    <description>This Host has manifested Obito. The colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <renderNodeProperties>
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Obito mask</debugLabel>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>Head</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/ObitoMask</texPath>
        <coversFace>true</coversFace>
        <narrowHeadScale>(0.84, 0.7)</narrowHeadScale>
        <baseLayer>63</baseLayer>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <!-- Minato's hero form (AG_Echo_Minato). While it is on, his thrown kunai are sealed (KunaiSeal) and his
       melee hits leave sealing touch (SealingTouch.cs). The haori is drawn like Vergil's coat: the
       Host's clothes, armour and headgear are hidden but still worn and counted, belts and packs still
       drawn, and facing north it goes over the head so its collar covers the nape. The forehead
       protector is on the head over the hair (62); the same on both sides, so west is east mirrored.
       Textures: make_costume_textures.py. -->
  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Minato</defName>
    <label>hero form: Minato</label>
    <description>This Host has manifested Minato. The Echo's abilities are available and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.\n\nEvery kunai he throws carries his Flying Thunder God seal. Sealing touch: each of his melee hits that lands seals the pawn it struck for one day; he keeps 3 seals at a time and a new one replaces the oldest.</description>
    <renderNodeProperties>
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Minato haori</debugLabel>
        <hideBodyApparel>true</hideBodyApparel>
        <hideHeadgear>true</hideHeadgear>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>ApparelBody</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/MinatoHaori_Thin</texPath>
        <bodyTypeGraphicPaths>
          <Thin>RimArt/Echo/Costume/MinatoHaori_Thin</Thin>
          <Male>RimArt/Echo/Costume/MinatoHaori_Male</Male>
          <Female>RimArt/Echo/Costume/MinatoHaori_Female</Female>
          <Fat>RimArt/Echo/Costume/MinatoHaori_Fat</Fat>
          <Hulk>RimArt/Echo/Costume/MinatoHaori_Hulk</Hulk>
        </bodyTypeGraphicPaths>
        <baseLayer>29</baseLayer>
        <drawData>
          <dataNorth>
            <layer>89</layer>
          </dataNorth>
        </drawData>
      </li>
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Minato forehead protector</debugLabel>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>Head</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/MinatoHeadband</texPath>
        <narrowHeadScale>(0.84, 0.7)</narrowHeadScale>
        <baseLayer>63</baseLayer>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <!-- Sasuke's hero form. No Echo points here yet: his EchoDef (docs/hero-echo.md, "Sasuke") comes with
       his kit's port and names this as its manifestHediff. His Fourth War outfit is drawn like Minato's
       haori: the Host's clothes, armour and headgear are hidden but still worn and counted, belts and
       packs still drawn, and facing north it goes over the head so its collar covers the nape. West is
       its own picture: the rope's two ends hang on his right side, its loop on his left.
       Textures: make_costume_textures.py. -->
  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Sasuke</defName>
    <label>hero form: Sasuke</label>
    <description>This Host has manifested Sasuke. The colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <renderNodeProperties>
      <li Class="RimArt.PawnRenderNodeProperties_EchoCostume">
        <debugLabel>Sasuke outfit</debugLabel>
        <hideBodyApparel>true</hideBodyApparel>
        <hideHeadgear>true</hideHeadgear>
        <workerClass>RimArt.PawnRenderNodeWorker_EchoCostume</workerClass>
        <parentTagDef>ApparelBody</parentTagDef>
        <pawnType>HumanlikeOnly</pawnType>
        <texPath>RimArt/Echo/Costume/SasukeOutfit_Thin</texPath>
        <bodyTypeGraphicPaths>
          <Thin>RimArt/Echo/Costume/SasukeOutfit_Thin</Thin>
          <Male>RimArt/Echo/Costume/SasukeOutfit_Male</Male>
          <Female>RimArt/Echo/Costume/SasukeOutfit_Female</Female>
          <Fat>RimArt/Echo/Costume/SasukeOutfit_Fat</Fat>
          <Hulk>RimArt/Echo/Costume/SasukeOutfit_Hulk</Hulk>
        </bodyTypeGraphicPaths>
        <baseLayer>29</baseLayer>
        <drawData>
          <dataNorth>
            <layer>89</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Goku</defName>
    <label>hero form: Goku</label>
    <description>This Host has manifested Goku. The Echo's abilities are available and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.5</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="AG_EchoManifestBase">
    <defName>AG_EchoManifest_Todo</defName>
    <label>hero form: Todo</label>
    <description>This Host has manifested Todo. The Echo's abilities are available, the anchor organ is awake and the colony's charge drains while the form lasts. Hero form fights and moves but does no colony work.</description>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.5</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- When the pool runs dry every manifested Host reverts and collapses for a while. -->
  <HediffDef>
    <defName>AG_EchoCollapse</defName>
    <label>echo collapse</label>
    <description>The Echo left this Host all at once when the colony's charge ran out. The body cannot stand until it recovers.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <defaultLabelColor>(0.9, 0.5, 0.4)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
