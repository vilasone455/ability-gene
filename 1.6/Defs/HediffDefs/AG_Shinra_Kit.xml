<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Retained so old saves can resolve their developer grant before migration. -->
  <HediffDef>
    <defName>AG_ShinraTenseiKit</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>Shinra Tensei (legacy grant)</label>
    <description>A legacy developer grant, converted to a repulsion eye when the game loads.</description>
    <isBad>false</isBad>
  </HediffDef>
  <!-- Echo-only since the Pain port (docs/hero-echo.md): the eye grants no ability and is no longer a
       quest reward. The def stays loadable for saves and pawns that hold one. -->
  <HediffDef ParentName="AddedBodyPartBase">
    <defName>AG_RepulsionEye</defName>
    <label>repulsion eye</label>
    <labelNoun>a repulsion eye</labelNoun>
    <description>An artificial eye supplying normal sight. Shinra Tensei comes from Pain's Echo since the hero port; the eye no longer grants it.</description>
    <spawnThingOnRemoved>AG_RepulsionEye</spawnThingOnRemoved>
    <addedPartProps><solid>true</solid><partEfficiency>1</partEfficiency></addedPartProps>
  </HediffDef>
</Defs>
