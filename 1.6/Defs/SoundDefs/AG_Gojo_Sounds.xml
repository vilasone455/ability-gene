<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Gojo's sounds for Blue, Red and Hollow Purple, picked by ear in the VFX lab against the sketches
       gojo-blue-v2.js, gojo-red-v2.js and gojo-purple.js (Tools/SoundLab/picks.json, "sound:<defName>").
       Core's clips and the mod's own synthesized ones (Sounds/AG/, written by make_sounds.py) at the lab's
       pitches and volumes; no DLC clip, so no layer needs MayRequire. Volume and pitch are single values, as
       picked; a folder plays one of its clips at random. Blue names its three on AG_GojoBlue's Gravity Well comp
       (openSound, holdSound, implodeSound); Red and Purple play theirs through SoundLayers. The two sustainers
       (Blue's pull, Purple's travel) run until the cast ends them and fade out over 0.2 s, as the lab cuts them.
       No sound, by choice: Red's charge and its landing in the open, Purple's ignition and its touch on a pawn.
       Unlimited Void's sounds are not decided yet. -->

  <!-- Blue opens, 0.15 s after the cast (the arm is up): the ball grows at the cell. -->
  <SoundDef>
    <defName>AG_GojoBlueOpen</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>AG/KamuiIn</clipFolderPath></li></grains>
        <volumeRange>40~40</volumeRange>
        <pitchRange>1.3~1.3</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Blue's pull, from when the ball is full until it implodes or closes (3 s): Gravity Well's hum clip, louder,
       over a tornado. -->
  <SoundDef>
    <defName>AG_GojoBluePull</defName>
    <context>MapOnly</context>
    <sustain>true</sustain>
    <sustainFadeoutTime>0.2</sustainFadeoutTime>
    <maxSimultaneous>4</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Misc/Artifacts/Psychic_Animal_Pulser</clipFolderPath></li></grains>
        <volumeRange>25~25</volumeRange>
        <pitchRange>0.45~0.45</pitchRange>
        <sustainLoop>true</sustainLoop>
      </li>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Misc/Tornado</clipFolderPath></li></grains>
        <volumeRange>25~25</volumeRange>
        <pitchRange>0.9~0.9</pitchRange>
        <sustainLoop>true</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Blue implodes, on the tick its damage is dealt (the picture's flash): Gravity Well's implosion at one pitch. -->
  <SoundDef>
    <defName>AG_GojoBlueImplode</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Weapon/Artillery/Mortar_Explode_Dry</clipFolderPath></li></grains>
        <volumeRange>28~28</volumeRange>
        <pitchRange>0.475~0.475</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Red leaves the finger (the fire tick), at Gojo. Also the first sound of Hollow Purple, which is a Red cast. -->
  <SoundDef>
    <defName>AG_GojoRedFire</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Weapon/ThumpCannon_Fire</clipFolderPath></li></grains>
        <volumeRange>45~45</volumeRange>
        <pitchRange>1.1~1.1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Red bursts where it meets a pawn, a thing, a wall or its cell. -->
  <SoundDef>
    <defName>AG_GojoRedBurst</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>AG/RasenganHit</clipFolderPath></li></grains>
        <volumeRange>50~50</volumeRange>
        <pitchRange>1.2~1.2</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- The thing Red threw lands against a wall (the +10 slam), where it lands. -->
  <SoundDef>
    <defName>AG_GojoRedSlam</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Pawn/Animal/Melee_Big/Hit_Building</clipFolderPath></li></grains>
        <volumeRange>55~55</volumeRange>
        <pitchRange>0.8~0.8</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Red meets Blue and Hollow Purple forms, at Blue's centre: the two spiral in for 0.35 s. -->
  <SoundDef>
    <defName>AG_GojoPurpleMerge</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>AG/KamuiIn</clipFolderPath></li></grains>
        <volumeRange>45~45</volumeRange>
        <pitchRange>1~1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Hollow Purple travels, heard from the sphere as it moves, until it stops (5 s for its 30 cells). -->
  <SoundDef>
    <defName>AG_GojoPurpleTravel</defName>
    <context>MapOnly</context>
    <sustain>true</sustain>
    <sustainFadeoutTime>0.2</sustainFadeoutTime>
    <maxSimultaneous>4</maxSimultaneous>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Clip"><clipPath>Weapon/Flamethrower/Flamthrower_Firing_Loop_A</clipPath></li></grains>
        <volumeRange>45~45</volumeRange>
        <pitchRange>0.6~0.6</pitchRange>
        <sustainLoop>true</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Hollow Purple stops and fades into specks, where it stopped. -->
  <SoundDef>
    <defName>AG_GojoPurpleFade</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains><li Class="AudioGrain_Folder"><clipFolderPath>Explosion/Vaporize</clipFolderPath></li></grains>
        <volumeRange>30~30</volumeRange>
        <pitchRange>1~1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>
</Defs>
