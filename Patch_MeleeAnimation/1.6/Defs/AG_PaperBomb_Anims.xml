<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- The Paper Bomb kit's clips. Written by make_paper_bomb_anim.py. Nothing starts them yet: the
       kit is at sketch stage and has no abilities or C#. They are defined now so the clips can be
       checked in the VFX lab and in Melee Animation's own previewer.

       The tag scroll is a Scroll part in the off hand, not ItemA, so Melee Animation does not swap
       its texture for the pawn's melee weapon. The three aimed clips have east (mirrored for west),
       north and south files, and ThrowAimWorker turns the hand and what it holds to the exact
       angle, as for the throws in AG_Throw_Anims.xml. TagSeal, the hand seal, is not aimed: one
       clip, the pawn facing south, like the Anchor's clap. -->
  <AM.AnimDef>
    <defName>AG_TagThrow</defName>
    <label>Paper Bomb: tag throw, east or west</label>
    <description>Tearing a tag off the scroll and throwing it on a pin.</description>
    <jobString>Throwing a tag.</jobString>
    <type>Other</type>
    <pawnCount>1</pawnCount>
    <data>RimArt_TagThrow.json</data>
    <rendererWorker>RimArt.MeleeAnimation.ThrowAimWorker</rendererWorker>
    <cellData><li><type>PawnStart</type><position>(0, 0)</position><pawnIndex>0</pawnIndex></li></cellData>
    <handsVisibility><li><pawnIndex>0</pawnIndex><showMainHand>true</showMainHand><showAltHand>true</showAltHand></li></handsVisibility>
    <canEditProbability>false</canEditProbability>
  </AM.AnimDef>
