<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- The Power Pole's hands and body for Extend Thrust, Sweep and the plant that starts Vault
       Strike. Written by make_power_pole_anim.py; started by RimArt.JobDriver_CastPowerPole through
       RimArt.PowerPoleCastAnimation, tied to the AG_CastPowerPole job, which owns the clock.

       No weapon part: the pole is drawn by RimArt.dll, long, and the clips put the two hands on it.
       Four clips per ability, east, north, south and west, and none is mirrored, because a mirrored
       Sweep would swing the wrong way. ThrowAimWorker turns the hands to the exact angle, as for
       the throws in AG_Throw_Anims.xml. -->
  <AM.AnimDef>
    <defName>AG_PoleThrustEast</defName>
    <label>Power Pole: extend thrust, east</label>
    <description>Extending the Power Pole at a target.</description>
    <jobString>Thrusting the pole.</jobString>
    <type>Other</type>
    <pawnCount>1</pawnCount>
    <data>RimArt_PoleThrustEast.json</data>
    <rendererWorker>RimArt.MeleeAnimation.ThrowAimWorker</rendererWorker>
    <cellData><li><type>PawnStart</type><position>(0, 0)</position><pawnIndex>0</pawnIndex></li></cellData>
    <handsVisibility><li><pawnIndex>0</pawnIndex><showMainHand>true</showMainHand><showAltHand>true</showAltHand></li></handsVisibility>
    <canEditProbability>false</canEditProbability>
  </AM.AnimDef>
